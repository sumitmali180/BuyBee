@model EMart.ViewModels.ReorderHubVM

@{
    ViewData["Title"] = "AI Smart Reorder Hub - Buy Again";
    bool isGuest = ViewBag.IsGuest == true;
}

<div class="container py-4 py-md-5">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Smart Reorder Hub</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-arrow-repeat text-warning"></i>
                <span>Smart Reorder Hub</span>
                <span class="badge bg-dark text-warning border border-warning rounded-pill fs-6 px-3">AI Powered</span>
            </h1>
            <p class="text-muted small mt-1 mb-0">Never run out of daily pantry staples, personal care products, and household essentials.</p>
        </div>

        <div class="d-flex gap-2">
            @if (Model.TotalDueCount > 0)
            {
                <button id="btnReorderAllDue" class="btn btn-warning text-dark fw-bold px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-cart-plus-fill"></i>
                    <span>Reorder All @Model.TotalDueCount Due Items</span>
                </button>
            }
            <a asp-controller="BeeCoins" asp-action="Index" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center gap-2">
                <span>🪙</span>
                <span>My BeeCoins</span>
            </a>
        </div>
    </div>

    @if (isGuest)
    {
        <div class="alert alert-warning rounded-4 shadow-sm p-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill fs-4 text-warning"></i>
                <div>
                    <strong>Viewing Curated Reorder Staples:</strong>
                    <span class="text-muted small">Sign in to see personalized replenishment cadence calculated from your actual order history.</span>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Reorder" class="btn btn-dark btn-sm px-3">
                Sign In to Personalize
            </a>
        </div>
    }

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border rounded-3 p-3 bg-white shadow-sm">
                <div class="text-muted small text-uppercase fw-semibold" style="font-size: 11px;">Due for Replenishment</div>
                <div class="fs-4 fw-bold text-danger mt-1 font-monospace">@Model.TotalDueCount <span class="text-muted small fs-6">Items</span></div>
                <div class="text-muted small mt-1">Based on estimated usage cycle</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border rounded-3 p-3 bg-white shadow-sm">
                <div class="text-muted small text-uppercase fw-semibold" style="font-size: 11px;">Saved Favorites</div>
                <div class="fs-4 fw-bold text-dark mt-1 font-monospace">@Model.TotalItemsCount <span class="text-muted small fs-6">Items</span></div>
                <div class="text-muted small mt-1">From previous purchases</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border rounded-3 p-3 bg-white shadow-sm">
                <div class="text-muted small text-uppercase fw-semibold" style="font-size: 11px;">Potential BeeCoins</div>
                <div class="fs-4 fw-bold text-amber mt-1 font-monospace">+@Model.PotentialBeeCoinsEarned <span class="text-warning small fs-6">Coins</span></div>
                <div class="text-success small mt-1">₹@Model.PotentialBeeCoinsEarned cash back value</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border rounded-3 p-3 bg-white shadow-sm">
                <div class="text-muted small text-uppercase fw-semibold" style="font-size: 11px;">Express Shipping</div>
                <div class="fs-4 fw-bold text-success mt-1">Free &gt; ₹999</div>
                <div class="text-muted small mt-1">Direct to your doorstep</div>
            </div>
        </div>
    </div>

    <!-- Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-4 pb-2 border-bottom">
        <button class="btn btn-sm btn-dark px-3 rounded-pill filter-btn active" data-filter="all">
            All Items (@Model.TotalItemsCount)
        </button>
        <button class="btn btn-sm btn-outline-secondary px-3 rounded-pill filter-btn" data-filter="due">
            ⚡ Due for Reorder (@Model.TotalDueCount)
        </button>
        <button class="btn btn-sm btn-outline-secondary px-3 rounded-pill filter-btn" data-filter="fmcg">
            🛒 Groceries & FMCG
        </button>
        <button class="btn btn-sm btn-outline-secondary px-3 rounded-pill filter-btn" data-filter="personal">
            🧴 Personal Care
        </button>
    </div>

    <!-- Reorder Items Grid -->
    @if (Model.AllPastItems.Any())
    {
        <div class="row g-4" id="reorderGrid">
            @foreach (var item in Model.AllPastItems)
            {
                string filterCategory = "other";
                if (item.CategoryId == 2) filterCategory = "fmcg";
                else if (item.CategoryId == 3) filterCategory = "personal";

                <div class="col-sm-6 col-lg-4 col-xl-3 reorder-card-col" 
                     data-due="@(item.IsDueForReorder ? "true" : "false")"
                     data-cat="@filterCategory">
                    <div class="card h-100 border rounded-4 shadow-sm overflow-hidden bg-white d-flex flex-column transition-all hover-lift">
                        <!-- Product Thumbnail & Badges -->
                        <div class="position-relative bg-light text-center p-3" style="min-height: 180px;">
                            @if (item.IsDueForReorder)
                            {
                                <span class="position-absolute top-0 start-0 m-2 badge bg-danger text-white rounded-pill px-2 py-1 shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 10px;">
                                    <i class="bi bi-alarm-fill"></i> Due Soon
                                </span>
                            }
                            else if (item.TimesOrdered >= 2)
                            {
                                <span class="position-absolute top-0 start-0 m-2 badge bg-warning text-dark rounded-pill px-2 py-1 shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 10px;">
                                    <i class="bi bi-heart-fill text-danger"></i> Favorite
                                </span>
                            }

                            <span class="position-absolute top-0 end-0 m-2 badge bg-white text-secondary border rounded-pill" style="font-size: 10px;">
                                @item.CategoryName
                            </span>

                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="d-block text-decoration-none">
                                <img src="@(string.IsNullOrEmpty(item.ThumbnailImage) ? "/images/placeholder.png" : item.ThumbnailImage)"
                                     alt="@item.ProductName"
                                     class="img-fluid object-fit-contain my-2"
                                     style="max-height: 130px;"
                                     onerror="this.src='/images/placeholder.png'" />
                            </a>
                        </div>

                        <!-- Card Body -->
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <div class="text-muted small text-uppercase" style="font-size: 10px;">@item.BrandName</div>
                            <h3 class="h6 fw-bold text-dark mb-1 text-truncate" title="@item.ProductName">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">
                                    @item.ProductName
                                </a>
                            </h3>

                            <!-- AI Cadence Reason Badge -->
                            <div class="p-2 bg-light rounded-3 small text-muted mb-3 d-flex align-items-center gap-2" style="font-size: 11px;">
                                <i class="bi bi-robot text-warning fs-6"></i>
                                <div class="text-truncate">@item.AiReason</div>
                            </div>

                            <!-- Price & Stock -->
                            <div class="d-flex justify-content-between align-items-center mb-3 mt-auto">
                                <div>
                                    <div class="fs-5 fw-bold text-dark">₹@item.Price.ToString("N2")</div>
                                    <small class="text-success" style="font-size: 11px;">+@((int)(item.Price / 100) * 5) BeeCoins</small>
                                </div>
                                <div>
                                    @if (item.IsInStock)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="font-size: 10px;">In Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25" style="font-size: 10px;">Out of Stock</span>
                                    }
                                </div>
                            </div>

                            <!-- Actions: Stepper + Reorder Button -->
                            <div class="d-flex gap-2 align-items-center pt-2 border-top">
                                <div class="input-group input-group-sm" style="width: 90px;">
                                    <button class="btn btn-outline-secondary btn-qty-minus" type="button">-</button>
                                    <input type="text" class="form-control text-center input-qty" value="1" readonly style="max-width: 40px;" />
                                    <button class="btn btn-outline-secondary btn-qty-plus" type="button">+</button>
                                </div>

                                <button class="btn btn-warning btn-sm text-dark fw-bold flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1 btn-reorder"
                                        data-product-id="@item.ProductId"
                                        @(item.IsInStock ? "" : "disabled")>
                                    <i class="bi bi-arrow-repeat"></i>
                                    <span>Reorder</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border rounded-4 p-5 text-center bg-white shadow-sm my-4">
            <i class="bi bi-basket3 text-warning display-3 d-block mb-3 opacity-50"></i>
            <h4 class="fw-bold mb-2">No Past Orders Found</h4>
            <p class="text-muted small mb-4">Once you place orders for household items or groceries, your replenishment cycles will automatically appear here.</p>
            <div>
                <a asp-controller="Products" asp-action="Category" asp-route-id="2" class="btn btn-warning text-dark fw-bold px-4">
                    Shop Pantry Staples
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Filter pills
        const filterButtons = document.querySelectorAll('.filter-btn');
        const cards = document.querySelectorAll('.reorder-card-col');

        filterButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                filterButtons.forEach(b => {
                    b.classList.remove('btn-dark', 'active');
                    b.classList.add('btn-outline-secondary');
                });
                this.classList.add('btn-dark', 'active');
                this.classList.remove('btn-outline-secondary');

                const filter = this.getAttribute('data-filter');
                cards.forEach(card => {
                    if (filter === 'all') {
                        card.style.display = '';
                    } else if (filter === 'due') {
                        card.style.display = card.getAttribute('data-due') === 'true' ? '' : 'none';
                    } else if (filter === 'fmcg') {
                        card.style.display = card.getAttribute('data-cat') === 'fmcg' ? '' : 'none';
                    } else if (filter === 'personal') {
                        card.style.display = card.getAttribute('data-cat') === 'personal' ? '' : 'none';
                    }
                });
            });
        });

        // Quantity Steppers
        document.querySelectorAll('.reorder-card-col').forEach(card => {
            const minusBtn = card.querySelector('.btn-qty-minus');
            const plusBtn = card.querySelector('.btn-qty-plus');
            const qtyInput = card.querySelector('.input-qty');

            minusBtn.addEventListener('click', function () {
                let val = parseInt(qtyInput.value) || 1;
                if (val > 1) qtyInput.value = val - 1;
            });

            plusBtn.addEventListener('click', function () {
                let val = parseInt(qtyInput.value) || 1;
                if (val < 10) qtyInput.value = val + 1;
            });

            // Reorder Single
            const reorderBtn = card.querySelector('.btn-reorder');
            reorderBtn.addEventListener('click', async function () {
                const productId = parseInt(this.getAttribute('data-product-id'));
                const quantity = parseInt(qtyInput.value) || 1;
                const origText = this.innerHTML;

                this.disabled = true;
                this.innerHTML = `<span class="spinner-border spinner-border-sm" role="status"></span> Adding...`;

                try {
                    const resp = await fetch('/Reorder/ReorderSingle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, quantity })
                    });
                    const res = await resp.json();
                    if (res.success) {
                        this.innerHTML = `<i class="bi bi-check-lg text-success"></i> Added!`;
                        this.classList.remove('btn-warning');
                        this.classList.add('btn-success', 'text-white');
                        
                        // Update cart badge if present
                        const cartBadges = document.querySelectorAll('.bb-cart-badge');
                        cartBadges.forEach(b => {
                            b.textContent = res.cartCount;
                            b.classList.remove('d-none');
                        });

                        setTimeout(() => {
                            this.innerHTML = origText;
                            this.classList.remove('btn-success', 'text-white');
                            this.classList.add('btn-warning', 'text-dark');
                            this.disabled = false;
                        }, 2000);
                    } else {
                        alert(res.message || 'Could not reorder item.');
                        this.innerHTML = origText;
                        this.disabled = false;
                    }
                } catch (e) {
                    alert('Error connecting to server.');
                    this.innerHTML = origText;
                    this.disabled = false;
                }
            });
        });

        // Reorder All Due
        const btnAllDue = document.getElementById('btnReorderAllDue');
        if (btnAllDue) {
            btnAllDue.addEventListener('click', async function () {
                const orig = this.innerHTML;
                this.disabled = true;
                this.innerHTML = `<span class="spinner-border spinner-border-sm" role="status"></span> Adding All Due Items...`;

                try {
                    const resp = await fetch('/Reorder/ReorderAllDue', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const res = await resp.json();
                    if (res.success) {
                        this.innerHTML = `<i class="bi bi-check-circle-fill"></i> ${res.message}`;
                        this.classList.remove('btn-warning');
                        this.classList.add('btn-success', 'text-white');

                        const cartBadges = document.querySelectorAll('.bb-cart-badge');
                        cartBadges.forEach(b => {
                            b.textContent = res.cartCount;
                            b.classList.remove('d-none');
                        });

                        setTimeout(() => {
                            window.location.href = '/Cart';
                        }, 1200);
                    } else {
                        alert(res.message);
                        this.innerHTML = orig;
                        this.disabled = false;
                    }
                } catch (e) {
                    alert('Error connecting to server.');
                    this.innerHTML = orig;
                    this.disabled = false;
                }
            });
        }
    });
</script>
}
