@model IEnumerable<EMart.Models.Addresses>

@{
    ViewData["Title"] = "My Saved Addresses";
}

<div class="container py-4 py-md-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile" class="text-decoration-none text-muted">My Profile</a></li>
                    <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Addresses</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0 text-dark">Saved Addresses</h1>
            <p class="text-muted small mb-0">Manage your delivery destinations for rapid checkout</p>
        </div>

        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Add New Address</span>
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="bb-card text-center py-5 px-3">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-geo-alt text-muted fs-2"></i>
            </div>
            <h2 class="h5 fw-bold text-dark mb-1">No Delivery Address Found</h2>
            <p class="text-muted small mb-4">Save an address now to accelerate your checkout process.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-plus-lg me-1"></i> Add Your First Address
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var address in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="bb-card h-100 d-flex flex-column p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-light border text-amber" style="width: 36px; height: 36px;">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                <span class="fw-semibold text-dark">Delivery Address</span>
                            </div>
                            <span class="badge bg-light text-muted border font-monospace">#@address.AddressId</span>
                        </div>

                        <div class="flex-grow-1 mb-4">
                            <p class="text-dark fw-medium mb-1">@address.AddressLine1</p>
                            <p class="text-secondary small mb-1">@address.City, @address.State</p>
                            <p class="text-muted small font-monospace mb-0">PIN: @address.Pincode</p>
                        </div>

                        <div class="d-flex gap-2 pt-3 border-top mt-auto">
                            <a asp-action="Edit"
                               asp-route-id="@address.AddressId"
                               class="btn btn-outline-secondary btn-sm flex-fill d-inline-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-pencil"></i>
                                <span>Edit</span>
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@address.AddressId"
                                  method="post"
                                  class="flex-fill"
                                  onsubmit="return confirm('Are you sure you wish to delete this address?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100 d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-trash"></i>
                                    <span>Delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>