@model EMart.Models.Addresses

@{
    ViewData["Title"] = "Edit Delivery Address";
}

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Saved Addresses</a></li>
                    <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Edit Address</li>
                </ol>
            </nav>

            <div class="bb-card p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-light border text-amber" style="width: 48px; height: 48px;">
                        <i class="bi bi-pencil-square fs-4"></i>
                    </div>
                    <div>
                        <h1 class="h4 fw-bold mb-1 text-dark">Edit Delivery Address</h1>
                        <p class="text-muted small mb-0">Update address details for current destination</p>
                    </div>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AddressId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="AddressLine1"
                                  class="form-control"
                                  placeholder="Street, building, flat or landmark"
                                  style="height: 100px;"></textarea>
                        <label asp-for="AddressLine1">Address Line (Street, Flat, House No.)</label>
                        <span asp-validation-for="AddressLine1" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="City" class="form-control" placeholder="City" />
                                <label asp-for="City">City</label>
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="State" class="form-control" placeholder="State" />
                                <label asp-for="State">State</label>
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Pincode" class="form-control" placeholder="PIN Code" />
                        <label asp-for="Pincode">PIN / Postal Code</label>
                        <span asp-validation-for="Pincode" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 d-inline-flex align-items-center gap-2">
                            <i class="bi bi-arrow-left"></i>
                            <span>Cancel</span>
                        </a>

                        <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2">
                            <i class="bi bi-check-lg"></i>
                            <span>Update Address</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}