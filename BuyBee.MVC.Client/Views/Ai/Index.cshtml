@model List<EMart.Models.Categories>
@{
    ViewData["Title"] = "AI Shopping Assistant - Buybee";
}

<div class="bb-ai-page">
    <div class="container">

        <!-- Hero Card -->
        <div class="bb-ai-hero-card">
            <div class="bb-ai-hero-badge">
                <i class="bi bi-stars"></i> Powered by Groq &amp; MCP Server
            </div>
            <h1 class="bb-ai-hero-title">
                Buybee <span>AI Personal Shopper</span>
            </h1>
            <p class="bb-ai-hero-subtitle">
                Ask natural questions to discover products, verify real-time inventory and stock levels, compare prices, and receive tailored recommendations directly from our live product catalog.
            </p>
            <div class="bb-ai-quick-tags">
                <button type="button" class="bb-ai-quick-tag" data-prompt="Show me popular smartphones under ₹50,000">
                    <i class="bi bi-phone"></i> Smartphones under ₹50,000
                </button>
                <button type="button" class="bb-ai-quick-tag" data-prompt="Find wireless noise cancelling headphones">
                    <i class="bi bi-headphones"></i> Best Noise-Cancelling Headphones
                </button>
                <button type="button" class="bb-ai-quick-tag" data-prompt="Check stock for Apple AirPods Pro">
                    <i class="bi bi-box-seam"></i> Check AirPods Pro Stock
                </button>
                <button type="button" class="bb-ai-quick-tag" data-prompt="What product categories do you sell in Buybee?">
                    <i class="bi bi-grid-fill"></i> Browse All Store Categories
                </button>
                <button type="button" class="bb-ai-quick-tag" data-prompt="Recommend gift ideas under ₹3000">
                    <i class="bi bi-gift-fill"></i> Gifts under ₹3,000
                </button>
            </div>
        </div>

        <!-- Main Content Area: Chat & Sidebar -->
        <div class="row g-4" id="bbAiPageContainer">
            
            <!-- Left: Interactive Chat Hub -->
            <div class="col-lg-8 col-xl-8">
                <div class="bb-ai-main-container">
                    
                    <!-- Chat Window Header -->
                    <div class="bb-ai-header">
                        <div class="bb-ai-title-wrap">
                            <div class="bb-ai-avatar p-0 overflow-hidden border border-warning" style="background: transparent;">
                                <img src="~/images/buybee-mascot-icon.png" asp-append-version="true" alt="BeeBot" width="38" height="38" style="object-fit: cover;" />
                            </div>
                            <div>
                                <h5 class="bb-ai-name mb-0">BeeBot Concierge</h5>
                                <div class="bb-ai-status">
                                    <span class="bb-ai-dot"></span>
                                    <span>Model: Groq LLM &bull; MCP Server Live</span>
                                </div>
                            </div>
                        </div>
                        <div class="bb-ai-actions">
                            <button type="button" class="bb-ai-action-btn" id="bbAiPageClearBtn" title="Reset Conversation">
                                <i class="bi bi-arrow-counterclockwise fs-5"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Messages Stream -->
                    <div class="bb-ai-page-messages">
                        <div class="bb-ai-msg assistant">
                            <div class="bb-ai-msg-avatar"><i class="bi bi-stars"></i></div>
                            <div class="bb-ai-bubble">
                                <p class="fw-bold mb-1">Hello! I'm BeeBot, your Buybee AI Shopping Assistant. 🛍️</p>
                                <p class="mb-2">
                                    I am directly connected to the <strong>Buybee MCP Server</strong> with live access to our database. I can:
                                </p>
                                <ul class="mb-2 ps-3">
                                    <li>Search products with prices, specifications, and images</li>
                                    <li>Check accurate, real-time inventory quantity and stock status</li>
                                    <li>Filter by category, brand, or custom budget range</li>
                                    <li>Help you add items directly to your cart with one click</li>
                                </ul>
                                <p class="mb-0 text-muted">
                                    Click any prompt above or type what you're looking for below!
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Suggestions Strip -->
                    <div class="bb-ai-suggestions border-top">
                        <button type="button" class="bb-ai-pill" data-prompt="Find electronics products">
                            <i class="bi bi-laptop"></i> Electronics
                        </button>
                        <button type="button" class="bb-ai-pill" data-prompt="Show Sony headphones">
                            <i class="bi bi-headphones"></i> Sony Audio
                        </button>
                        <button type="button" class="bb-ai-pill" data-prompt="Are there any items on sale or deals under ₹10,000?">
                            <i class="bi bi-tag-fill"></i> Deals under ₹10k
                        </button>
                        <button type="button" class="bb-ai-pill" data-prompt="Check stock status of Xiaomi 14">
                            <i class="bi bi-check2-circle"></i> Xiaomi 14 Stock
                        </button>
                    </div>

                    <!-- Chat Input Bar -->
                    <div class="bb-ai-input-bar">
                        <button type="button" class="bb-ai-btn-mic" title="Voice Search (Speech to Text)">
                            <i class="bi bi-mic-fill"></i>
                        </button>
                        <input type="text" class="bb-ai-input" placeholder="Type your shopping question or request here (e.g. 'Show me headphones under 30000')..." aria-label="Type message" />
                        <button type="button" class="bb-ai-btn-send" title="Send message">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>

                </div>
            </div>

            <!-- Right: MCP Tools & Categories Sidebar -->
            <div class="col-lg-4 col-xl-4">
                
                <!-- MCP Live Tools Status Card -->
                <div class="bb-ai-sidebar-card">
                    <h6 class="bb-ai-sidebar-title">
                        <i class="bi bi-hdd-network-fill text-warning"></i> Active MCP Server Tools
                    </h6>
                    <p class="text-muted small mb-3">
                        Connected to Buybee MCP Server with dynamic function calling:
                    </p>
                    <div class="bb-ai-tool-badge-item">
                        <span><i class="bi bi-search text-warning me-1"></i> search_products</span>
                        <span class="badge bg-success">Ready</span>
                    </div>
                    <div class="bb-ai-tool-badge-item">
                        <span><i class="bi bi-box-seam text-warning me-1"></i> check_product_stock</span>
                        <span class="badge bg-success">Ready</span>
                    </div>
                    <div class="bb-ai-tool-badge-item">
                        <span><i class="bi bi-info-circle text-warning me-1"></i> get_product_details</span>
                        <span class="badge bg-success">Ready</span>
                    </div>
                    <div class="bb-ai-tool-badge-item">
                        <span><i class="bi bi-diagram-3 text-warning me-1"></i> get_categories</span>
                        <span class="badge bg-success">Ready</span>
                    </div>
                    <div class="bb-ai-tool-badge-item">
                        <span><i class="bi bi-currency-rupee text-warning me-1"></i> find_products_by_price_range</span>
                        <span class="badge bg-success">Ready</span>
                    </div>
                    <div class="bb-ai-tool-badge-item">
                        <span><i class="bi bi-tag text-warning me-1"></i> find_products_by_brand</span>
                        <span class="badge bg-success">Ready</span>
                    </div>
                </div>

                <!-- Explore Categories -->
                @if (Model != null && Model.Any())
                {
                    <div class="bb-ai-sidebar-card">
                        <h6 class="bb-ai-sidebar-title">
                            <i class="bi bi-grid text-warning"></i> Explore Categories
                        </h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var cat in Model)
                            {
                                <button type="button" class="bb-ai-pill text-dark" data-prompt="Find popular products in category: @cat.CategoryName">
                                    @cat.CategoryName
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Tips & Sample Prompts -->
                <div class="bb-ai-sidebar-card">
                    <h6 class="bb-ai-sidebar-title">
                        <i class="bi bi-lightbulb-fill text-warning"></i> Smart AI Tips
                    </h6>
                    <ul class="text-secondary small mb-0 ps-3">
                        <li class="mb-2"><strong>Stock verification:</strong> Ask <em>"Is Sony WH-1000XM5 currently available?"</em></li>
                        <li class="mb-2"><strong>Budget constraints:</strong> Ask <em>"Show smartphones between ₹20,000 and ₹50,000"</em></li>
                        <li class="mb-2"><strong>Direct Add to Cart:</strong> Click the "Add to Cart" button right inside the chat card!</li>
                        <li><strong>Voice input:</strong> Click the microphone icon to speak naturally.</li>
                    </ul>
                </div>

            </div>

        </div>

    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/ai-assistant.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/ai-assistant.js" asp-append-version="true"></script>
}
