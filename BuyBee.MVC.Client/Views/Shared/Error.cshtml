@model ErrorViewModel
@{
    ViewData["Title"] = "System Notice";
}

<div class="container py-5 my-md-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="bb-card p-5">
                <span class="bb-badge bb-badge-rose px-3 py-1 mb-3">System Notice</span>
                <h1 class="h3 fw-bold text-dark mb-2">Something unexpected happened</h1>
                <p class="text-secondary small mb-4">
                    An unexpected event occurred while processing your request. Our engineering team has been notified.
                </p>

                @if (Model?.ShowRequestId ?? false)
                {
                    <div class="bg-light p-3 rounded-3 mb-4 text-start font-monospace small text-muted">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-house"></i>
                        <span>Return to Store</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
