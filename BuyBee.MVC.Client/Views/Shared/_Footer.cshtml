<footer class="bb-footer">
    <div class="container">
        <div class="row g-4">
            <!-- Brand Column -->
            <div class="col-lg-4 col-md-6 mb-2">
                <a asp-controller="Home" asp-action="Index" class="d-inline-block mb-3" aria-label="Buybee Home">
                    <img src="~/images/buybee-logo-white.svg" asp-append-version="true" alt="Buybee" height="36" />
                </a>
                <p class="text-secondary small pe-lg-4 mb-4" style="line-height: 1.65;">
                    Buybee is your energetic online shopping destination for electronics, fashion, smartphones, home essentials, and lifestyle brands with fast doorstep delivery.
                </p>
                <div class="d-flex align-items-center gap-3">
                    <a href="#" class="btn btn-sm btn-outline-secondary rounded-circle p-2" style="width: 36px; height: 36px;" aria-label="Facebook">
                        <i class="bi bi-facebook"></i>
                    </a>
                    <a href="#" class="btn btn-sm btn-outline-secondary rounded-circle p-2" style="width: 36px; height: 36px;" aria-label="Instagram">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <a href="#" class="btn btn-sm btn-outline-secondary rounded-circle p-2" style="width: 36px; height: 36px;" aria-label="Twitter">
                        <i class="bi bi-twitter-x"></i>
                    </a>
                    <a href="#" class="btn btn-sm btn-outline-secondary rounded-circle p-2" style="width: 36px; height: 36px;" aria-label="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="col-lg-2 col-md-6 col-6">
                <h5>Explore</h5>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                    <li><a asp-controller="Products" asp-action="Index">All Products</a></li>
                    <li><a asp-controller="Products" asp-action="Index" asp-route-sortBy="price_asc">Today's Deals</a></li>
                    <li><a asp-controller="Ai" asp-action="Index">BeeBot AI</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                </ul>
            </div>

            <!-- Customer Service -->
            <div class="col-lg-3 col-md-6 col-6">
                <h5>Customer Hub</h5>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    <li><a asp-area="" asp-controller="Account" asp-action="Profile">My Account</a></li>
                    <li><a asp-area="" asp-controller="Order" asp-action="Index">Track Orders</a></li>
                    <li><a asp-area="" asp-controller="Cart" asp-action="Index">Shopping Cart</a></li>
                    <li><a asp-area="" asp-controller="Address" asp-action="Index">Delivery Addresses</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Help">Help &amp; FAQs</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Contact">Contact Support</a></li>
                </ul>
            </div>

            <!-- Contact & Hours -->
            <div class="col-lg-3 col-md-6">
                <h5>Direct Contact</h5>
                <ul class="list-unstyled text-secondary small d-flex flex-column gap-2 mb-3">
                    <li class="d-flex align-items-center gap-2">
                        <i class="bi bi-telephone text-warning"></i>
                        <span>+91 9876543210</span>
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="bi bi-envelope text-warning"></i>
                        <span>support@buybee.com</span>
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt text-warning"></i>
                        <span>Pune, Maharashtra, India</span>
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock text-warning"></i>
                        <span>Mon - Sat : 9:00 AM - 8:00 PM</span>
                    </li>
                </ul>
                <div class="bg-dark p-2 rounded-3 border border-secondary border-opacity-25 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-success fs-5"></i>
                    <span class="small text-light">100% Encrypted Checkout</span>
                </div>
            </div>
        </div>

        <!-- Footer Bottom -->
        <div class="bb-footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                &copy; @DateTime.Now.Year Buybee Commerce. All Rights Reserved.
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-secondary">Secured by SSL 256-Bit</span>
                <span>•</span>
                <span class="text-secondary">Fast Delivery Guarantee</span>
            </div>
        </div>
    </div>
</footer>