<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Buybee</title>
    <meta name="description" content="Buybee - Your premium online shopping destination for Electronics, Mobiles, Fashion, Home Appliances and more." />

    <link rel="icon" type="image/svg+xml" href="~/images/buybee-icon.svg" />
    <link rel="alternate icon" href="~/favicon.ico" />

    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Buybee Design System CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ai-assistant.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EMart.styles.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>

    <partial name="_Header" />

    <main role="main">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <!-- Bottom-Right Floating AI Shopping Assistant -->
    <partial name="_FloatingAssistant" />

    <!-- Cart Toast Notification -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 11000;">
        <div id="cartToast" class="toast align-items-center text-white bg-dark border-0 shadow-lg rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex p-3 align-items-center">
                <div class="toast-body d-flex align-items-center p-0 me-3">
                    <i class="bi bi-check-circle-fill text-warning fs-5 me-2" id="cartToastIcon"></i>
                    <span id="cartToastMsg" class="fw-semibold text-white">Product added to cart!</span>
                </div>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-sm btn-primary ms-auto me-2">
                    View Cart
                </a>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Back to Top Button -->
    <a href="#" id="btnTop" aria-label="Scroll to top">
        <i class="bi bi-arrow-up fs-5"></i>
    </a>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ai-assistant.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>