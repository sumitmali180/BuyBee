@model IEnumerable<EMart.Models.Brands>

@{
    var activeBrands = Model?.Where(b => b.IsActive).ToList();
}

@if (activeBrands != null && activeBrands.Any())
{
    <section class="py-5 bg-white border-top border-bottom border-light">
        <div class="container">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
                <div>
                    <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-patch-check-fill text-amber"></i>
                        <span>Official Brand Partners</span>
                    </h2>
                    <p class="text-muted mb-0 small">Authentic stock directly sourced from authorized brand manufacturers</p>
                </div>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm align-self-start align-self-sm-center d-inline-flex align-items-center gap-1">
                    <span>All Products</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
                @foreach (var brand in activeBrands)
                {
                    <div class="col">
                        <a asp-controller="Products"
                           asp-action="Brand"
                           asp-route-id="@brand.BrandId"
                           class="card h-100 text-decoration-none border p-3 text-center d-flex flex-column justify-content-between align-items-center bg-white bb-brand-card"
                           style="border-radius: var(--bb-radius); transition: transform var(--bb-transition-fast), border-color var(--bb-transition-fast), box-shadow var(--bb-transition-fast);">
                            <div class="d-flex align-items-center justify-content-center w-100 py-2" style="height: 60px;">
                                @if (!string.IsNullOrEmpty(brand.DisplayLogo))
                                {
                                    <img src="@brand.DisplayLogo"
                                         class="img-fluid"
                                         style="max-height: 46px; max-width: 100%; object-fit: contain; transition: transform var(--bb-transition-fast);"
                                         alt="@brand.BrandName Logo"
                                         onerror="this.onerror=null; this.src='/images/buybee-icon.svg';" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                                         style="width: 46px; height: 46px; color: var(--bb-amber-700);">
                                        <i class="bi bi-patch-check-fill fs-4"></i>
                                    </div>
                                }
                            </div>
                            <span class="fw-semibold text-dark small text-truncate w-100 mt-2 pt-2 border-top border-light">
                                @brand.BrandName
                            </span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}