@model EMart.ViewModels.HomeVM
@inject EMart.Repositories.Interfaces.IReorderRepository ReorderRepo

@{
    ViewData["Title"] = "Smart Shopping, Everyday Value";
    List<EMart.ViewModels.ReorderItemVM>? homeReorders = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        var cidClaim = User.FindFirst("CustomerId")?.Value;
        if (int.TryParse(cidClaim, out int cid) && cid > 0)
        {
            homeReorders = await ReorderRepo.GetTopReorderSuggestions(cid, 4);
        }
    }
}

<!-- Buybee Hero Banner -->
<partial name="_HeroBanner" />

@if (homeReorders != null && homeReorders.Any())
{
    <!-- AI Smart Reorder (Buy Again) Strip -->
    <section class="py-4 bg-white border-bottom">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div>
                    <span class="text-uppercase fw-bold text-warning small tracking-wider" style="font-size: 11px;">Personalized for You</span>
                    <h2 class="h5 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-arrow-repeat text-warning"></i>
                        <span>Buy Again &amp; Replenish</span>
                        <span class="badge bg-dark text-warning border border-warning rounded-pill" style="font-size: 10px;">1-Click</span>
                    </h2>
                </div>
                <a asp-controller="Reorder" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                    View Reorder Hub &rarr;
                </a>
            </div>

            <div class="row g-3">
                @foreach (var rItem in homeReorders)
                {
                    <div class="col-sm-6 col-md-3">
                        <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm transition-all hover-lift">
                            <div class="d-flex gap-3 align-items-center">
                                <img src="@(string.IsNullOrEmpty(rItem.ThumbnailImage) ? "/images/placeholder.png" : rItem.ThumbnailImage)" 
                                     alt="@rItem.ProductName" 
                                     class="rounded-2 bg-white p-1 border object-fit-contain" 
                                     style="width: 55px; height: 55px;"
                                     onerror="this.src='/images/placeholder.png'" />
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="small fw-bold text-dark text-truncate" title="@rItem.ProductName">@rItem.ProductName</div>
                                    <div class="fw-bold text-amber small font-monospace">₹@rItem.Price.ToString("N2")</div>
                                    <small class="text-muted text-truncate d-block" style="font-size: 10px;">@rItem.AiReason</small>
                                </div>
                            </div>
                            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="badge bg-white text-secondary border" style="font-size: 9px;">@rItem.CategoryName</span>
                                <a asp-controller="Reorder" asp-action="Index" class="btn btn-warning btn-sm py-0 px-2 fw-bold text-dark" style="font-size: 11px;">
                                    Reorder &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Shop by Dynamic Categories -->
<partial name="_Categories" model="Model.Categories" />

<!-- Trending Products Section with Pagination -->
<partial name="_Products" model="Model.AllProducts" />

<!-- Latest Arrivals -->
<partial name="_LatestProducts" model="Model.LatestProducts" />

<!-- Featured Products -->
<partial name="_FeaturedProducts" model="Model.FeaturedProducts" />

<!-- Official Brands -->
<partial name="_TopBrands" model="Model.Brands" />

<!-- Buybee Trust & Value Propositions -->
<section class="py-5 bg-white border-top border-light">
    <div class="container">
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <div class="bb-value-item">
                    <div class="bb-value-icon">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div>
                        <h4 class="h6 fw-bold mb-1">Free Delivery</h4>
                        <p class="text-muted small mb-0">On qualified orders over ₹999 across India</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="bb-value-item">
                    <div class="bb-value-icon">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <div>
                        <h4 class="h6 fw-bold mb-1">7-Day Easy Returns</h4>
                        <p class="text-muted small mb-0">Hassle-free exchange and instant returns</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="bb-value-item">
                    <div class="bb-value-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h4 class="h6 fw-bold mb-1">Secure Checkout</h4>
                        <p class="text-muted small mb-0">256-bit encrypted transactions and COD</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="bb-value-item">
                    <div class="bb-value-icon">
                        <i class="bi bi-headset"></i>
                    </div>
                    <div>
                        <h4 class="h6 fw-bold mb-1">Helpful Support</h4>
                        <p class="text-muted small mb-0">Direct phone & email support 6 days a week</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
