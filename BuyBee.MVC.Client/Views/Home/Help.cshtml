@{
    ViewData["Title"] = "Help & FAQs - Buybee Commerce";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">
            Support Hub
        </span>
        <h1 class="fw-bold text-dark">Frequently Asked Questions</h1>
        <p class="text-secondary">Find instant answers to common questions about orders, shipping, and payments.</p>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-lg-10">
            <div class="accordion accordion-flush shadow-sm rounded-4 overflow-hidden border bg-white" id="faqAccordion">
                <!-- Item 1 -->
                <div class="accordion-item border-bottom">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button fw-semibold text-dark collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                            <i class="bi bi-truck me-3 text-warning fs-5"></i> What are your delivery timelines and shipping charges?
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-secondary">
                            We offer <strong>Free Express Shipping</strong> on all orders above ₹999. Standard delivery typically takes 2 to 4 business days depending on your location across India. Express courier tracking is provided instantly once your package is dispatched.
                        </div>
                    </div>
                </div>

                <!-- Item 2 -->
                <div class="accordion-item border-bottom">
                    <h2 class="accordion-header" id="headingTwo">
                        <button class="accordion-button fw-semibold text-dark collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                            <i class="bi bi-arrow-repeat me-3 text-warning fs-5"></i> What is your return and replacement policy?
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-secondary">
                            Buybee offers a <strong>7-Day Hassle-Free Return / Replacement Policy</strong> on eligible categories. If an item arrives damaged, defective, or incorrect, you can request a return directly from your <em>My Orders</em> section or by contacting customer support.
                        </div>
                    </div>
                </div>

                <!-- Item 3 -->
                <div class="accordion-item border-bottom">
                    <h2 class="accordion-header" id="headingThree">
                        <button class="accordion-button fw-semibold text-dark collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                            <i class="bi bi-credit-card me-3 text-warning fs-5"></i> What payment options do you support?
                        </button>
                    </h2>
                    <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-secondary">
                            We support <strong>Cash on Delivery (COD)</strong>, Credit/Debit Cards (Visa, MasterCard, RuPay), Net Banking, and Instant UPI (Google Pay, PhonePe, Paytm). All digital transactions are protected by 256-bit banking-grade SSL encryption.
                        </div>
                    </div>
                </div>

                <!-- Item 4 -->
                <div class="accordion-item border-bottom">
                    <h2 class="accordion-header" id="headingFour">
                        <button class="accordion-button fw-semibold text-dark collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                            <i class="bi bi-stars me-3 text-warning fs-5"></i> How does BeeBot AI assist me while shopping?
                        </button>
                    </h2>
                    <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-secondary">
                            BeeBot AI is your personal smart shopper! It connects to our live inventory via Model Context Protocol (MCP) and Groq LLMs. You can ask BeeBot to find laptops within your budget, check stock availability, compare headphones, or discover seasonal discounts anytime.
                        </div>
                    </div>
                </div>

                <!-- Item 5 -->
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingFive">
                        <button class="accordion-button fw-semibold text-dark collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                            <i class="bi bi-box-seam me-3 text-warning fs-5"></i> How can I track my active order?
                        </button>
                    </h2>
                    <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-secondary">
                            Once logged in, click on your profile in the top navbar and select <strong>My Orders</strong>, or navigate to <a href="/Order" class="text-warning fw-semibold">Track Orders</a>. You can inspect live order status, invoice summaries, and delivery estimates.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Need More Help Banner -->
    <div class="bg-light p-4 p-md-5 rounded-4 text-center border shadow-sm">
        <h4 class="fw-bold mb-2 text-dark">Still have questions?</h4>
        <p class="text-secondary mb-4">Our dedicated support team is available 6 days a week to help you.</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Contact" class="btn btn-warning px-4 py-2.5 fw-bold text-dark shadow-sm">
                <i class="bi bi-envelope-fill me-2"></i>Contact Support
            </a>
            <a href="tel:+919876543210" class="btn btn-outline-dark px-4 py-2.5 fw-semibold">
                <i class="bi bi-telephone-fill me-2"></i>+91 9876543210
            </a>
        </div>
    </div>
</div>
