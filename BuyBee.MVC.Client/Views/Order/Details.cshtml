@model EMart.ViewModels.OrderVM

@{
    ViewData["Title"] = "Order " + Model.Order.OrderNumber;
}

<div class="container py-4 py-md-5">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a asp-area="" asp-controller="Order" asp-action="Index" class="text-decoration-none text-muted">My Orders</a></li>
                    <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">@Model.Order.OrderNumber</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0 text-dark">
                Order <span class="text-secondary font-monospace">#@Model.Order.OrderNumber</span>
            </h1>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Track"
               asp-route-id="@Model.Order.OrderId"
               class="btn btn-warning btn-sm px-3 d-inline-flex align-items-center gap-2 fw-semibold text-dark shadow-sm">
                <i class="bi bi-geo-alt-fill"></i>
                <span>Track Live Shipment</span>
            </a>
            <a asp-action="Invoice"
               asp-route-id="@Model.Order.OrderId"
               target="_blank"
               class="btn btn-outline-secondary btn-sm px-3 d-inline-flex align-items-center gap-2">
                <i class="bi bi-printer"></i>
                <span>Tax Invoice</span>
            </a>
            <a asp-action="Index"
               class="btn btn-dark btn-sm px-3 d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i>
                <span>All Orders</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left: Items & Delivery Address -->
        <div class="col-lg-8">
            <!-- Interactive Visual Order Tracker -->
            @{
                var st = Model.Order.OrderStatus ?? "Pending";
                bool isCancelled = st.Equals("Cancelled", StringComparison.OrdinalIgnoreCase);
                int currentStep = 1;
                if (st.Equals("Confirmed", StringComparison.OrdinalIgnoreCase)) currentStep = 2;
                else if (st.Equals("Processing", StringComparison.OrdinalIgnoreCase) || st.Equals("Packed", StringComparison.OrdinalIgnoreCase)) currentStep = 3;
                else if (st.Equals("Shipped", StringComparison.OrdinalIgnoreCase) || st.Equals("Dispatched", StringComparison.OrdinalIgnoreCase) || st.Equals("Assigned", StringComparison.OrdinalIgnoreCase) || st.Equals("Out for Delivery", StringComparison.OrdinalIgnoreCase) || st.Equals("OutForDelivery", StringComparison.OrdinalIgnoreCase)) currentStep = 4;
                else if (st.Equals("Delivered", StringComparison.OrdinalIgnoreCase)) currentStep = 5;
            }

            <div class="card border shadow-sm rounded-4 p-4 mb-4 bg-white">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom">
                    <div>
                        <span class="text-uppercase fw-bold text-muted small tracking-wider" style="font-size: 11px;">Shipment Milestone Tracker</span>
                        <h5 class="fw-bold mb-0 text-dark">Delivery Progress</h5>
                    </div>
                    <div>
                        @if (isCancelled)
                        {
                            <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-x-circle me-1"></i> Cancelled</span>
                        }
                        else if (currentStep == 5)
                        {
                            <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check-circle me-1"></i> Delivered</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="bi bi-truck me-1"></i> @st</span>
                        }
                    </div>
                </div>

                @if (isCancelled)
                {
                    <div class="alert alert-danger mb-0 rounded-3 d-flex align-items-center gap-3">
                        <i class="bi bi-exclamation-octagon-fill fs-3"></i>
                        <div>
                            <div class="fw-bold">Order was cancelled</div>
                            <small>This order was cancelled and will not be processed further. If payment was made online, a refund will be credited within 3-5 business days.</small>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Visual Stepper Progress Bar -->
                    <div class="position-relative my-4 px-2">
                        <div class="progress" style="height: 4px;">
                            <div class="progress-bar bg-warning" role="progressbar" 
                                 style="width: @((currentStep - 1) * 25)%; transition: width 0.6s ease;" 
                                 aria-valuenow="@((currentStep - 1) * 25)" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <div class="d-flex justify-content-between position-relative" style="margin-top: -18px;">
                            <!-- Step 1: Placed -->
                            <div class="text-center" style="width: 70px;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-1 border shadow-sm @(currentStep >= 1 ? "bg-warning text-dark border-warning" : "bg-light text-muted")" style="width: 32px; height: 32px;">
                                    <i class="bi bi-receipt"></i>
                                </div>
                                <div class="small fw-bold @(currentStep >= 1 ? "text-dark" : "text-muted")" style="font-size: 11px;">Placed</div>
                                <div class="text-muted" style="font-size: 9px;">@Model.Order.OrderDate.ToString("dd MMM")</div>
                            </div>

                            <!-- Step 2: Confirmed -->
                            <div class="text-center" style="width: 70px;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-1 border shadow-sm @(currentStep >= 2 ? "bg-warning text-dark border-warning" : "bg-light text-muted")" style="width: 32px; height: 32px;">
                                    <i class="bi bi-shield-check"></i>
                                </div>
                                <div class="small fw-bold @(currentStep >= 2 ? "text-dark" : "text-muted")" style="font-size: 11px;">Confirmed</div>
                                <div class="text-muted" style="font-size: 9px;">@(currentStep >= 2 ? "Verified" : "--")</div>
                            </div>

                            <!-- Step 3: Packed / Processing -->
                            <div class="text-center" style="width: 70px;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-1 border shadow-sm @(currentStep >= 3 ? "bg-warning text-dark border-warning" : "bg-light text-muted")" style="width: 32px; height: 32px;">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                                <div class="small fw-bold @(currentStep >= 3 ? "text-dark" : "text-muted")" style="font-size: 11px;">Processing</div>
                                <div class="text-muted" style="font-size: 9px;">@(currentStep >= 3 ? "Packed" : "--")</div>
                            </div>

                            <!-- Step 4: Dispatched -->
                            <div class="text-center" style="width: 70px;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-1 border shadow-sm @(currentStep >= 4 ? "bg-warning text-dark border-warning" : "bg-light text-muted")" style="width: 32px; height: 32px;">
                                    <i class="bi bi-truck"></i>
                                </div>
                                <div class="small fw-bold @(currentStep >= 4 ? "text-dark" : "text-muted")" style="font-size: 11px;">Dispatched</div>
                                <div class="text-muted" style="font-size: 9px;">@(currentStep >= 4 ? "In Transit" : "--")</div>
                            </div>

                            <!-- Step 5: Delivered -->
                            <div class="text-center" style="width: 70px;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-1 border shadow-sm @(currentStep >= 5 ? "bg-success text-white border-success" : "bg-light text-muted")" style="width: 32px; height: 32px;">
                                    <i class="bi bi-house-check"></i>
                                </div>
                                <div class="small fw-bold @(currentStep >= 5 ? "text-success" : "text-muted")" style="font-size: 11px;">Delivered</div>
                                <div class="text-muted" style="font-size: 9px;">@(currentStep >= 5 ? "Completed" : "Expected")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Courier Info Subcard -->
                    <div class="p-3 bg-light rounded-3 border mt-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-white p-2 text-warning fs-4 border">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 10px;">Express Courier Partner</small>
                                <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.Order.CarrierName) ? "Buybee Logistics & Express (Air Surface)" : Model.Order.CarrierName)</div>
                                <small class="text-muted">Tracking AWB: <span class="font-monospace text-dark fw-semibold">@(string.IsNullOrEmpty(Model.Order.TrackingNumber) ? $"BB-{Model.Order.OrderNumber}" : Model.Order.TrackingNumber)</span></small>
                            </div>
                        </div>
                        <div class="d-flex flex-column align-items-sm-end gap-1">
                            @if (!string.IsNullOrEmpty(Model.Order.DeliveryOtp) && (st == "Dispatched" || st == "Shipped" || st == "Out for Delivery" || st == "Assigned" || st == "Delivered"))
                            {
                                <div class="d-flex align-items-center gap-1">
                                    <span class="small text-muted fw-semibold" style="font-size: 10px;">DELIVERY OTP:</span>
                                    <span class="badge bg-warning text-dark font-monospace fw-bold px-2 py-1">@Model.Order.DeliveryOtp</span>
                                </div>
                            }
                            <div>
                                <a asp-action="Track" asp-route-id="@Model.Order.OrderId" class="btn btn-outline-dark btn-sm py-1 px-3 fw-semibold d-inline-flex align-items-center gap-1">
                                    <span>Interactive Tracker</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Ordered Items -->
            <div class="bb-card p-0 mb-4 overflow-hidden">
                <div class="p-3 px-4 border-bottom bg-white d-flex align-items-center justify-content-between">
                    <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-box-seam text-amber"></i>
                        <span>Order Items</span>
                    </h2>
                    <span class="badge bg-light text-secondary border">@Model.OrderDetails.Count items</span>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light text-uppercase small text-muted">
                            <tr>
                                <th class="ps-4 py-3">Product</th>
                                <th class="py-3 text-center">Unit Price</th>
                                <th class="py-3 text-center">Qty</th>
                                <th class="pe-4 py-3 text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-semibold text-dark">@item.ProductName</div>
                                    </td>
                                    <td class="py-3 text-center text-muted">
                                        ₹@item.UnitPrice.ToString("N2")
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1">@item.Quantity</span>
                                    </td>
                                    <td class="pe-4 py-3 text-end fw-bold text-dark">
                                        ₹@item.Total.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Delivery Address Card -->
            @if (Model.Address != null)
            {
                <div class="bb-card p-4">
                    <h2 class="h6 fw-bold mb-3 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt text-amber"></i>
                        <span>Delivery Destination</span>
                    </h2>
                    <div class="p-3 bg-light rounded-3">
                        <div class="fw-semibold text-dark mb-1">Customer Delivery Address</div>
                        <div class="text-secondary">@Model.Address.AddressLine1</div>
                        <div class="text-secondary">@Model.Address.City, @Model.Address.State</div>
                        <div class="text-muted small mt-1 font-monospace">PIN: @Model.Address.Pincode</div>
                    </div>
                </div>
            }
        </div>

        <!-- Right: Order Summary & Actions -->
        <div class="col-lg-4">
            <div class="bb-card p-4 sticky-top" style="top: 90px;">
                <h2 class="h6 fw-bold mb-3 text-dark pb-2 border-bottom">
                    Payment & Summary
                </h2>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Items Subtotal</span>
                    <span class="fw-medium text-dark">₹@Model.Order.SubTotal.ToString("N2")</span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Delivery Charges</span>
                    <span class="text-success small fw-semibold">FREE</span>
                </div>

                @if (Model.Order.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-danger small">
                        <span>Discount Applied @(!string.IsNullOrEmpty(Model.Order.CouponCode) ? $"({Model.Order.CouponCode})" : "")</span>
                        <span class="fw-medium">- ₹@Model.Order.DiscountAmount.ToString("N2")</span>
                    </div>
                }

                @if (Model.Order.CoinsRedeemed > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-warning-emphasis small">
                        <span><i class="bi bi-coin text-warning me-1"></i> BeeCoins Redeemed (@Model.Order.CoinsRedeemed coins)</span>
                        <span class="fw-semibold">- ₹@Model.Order.CoinsDiscount.ToString("N2")</span>
                    </div>
                }

                @if (Model.Order.CoinsEarned > 0)
                {
                    <div class="p-2 bg-warning-subtle border border-warning-subtle rounded-2 mb-3 small d-flex align-items-center justify-content-between">
                        <span class="text-warning-emphasis fw-medium"><i class="bi bi-stars text-warning me-1"></i> BeeCoins Earned:</span>
                        <span class="badge bg-warning text-dark fw-bold">+@Model.Order.CoinsEarned Coins</span>
                    </div>
                }

                <div class="border-top pt-3 pb-3 mb-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark">Total Paid</span>
                    <span class="fs-4 fw-extrabold text-amber">₹@Model.Order.GrandTotal.ToString("N2")</span>
                </div>

                <div class="bg-light p-3 rounded-3 mb-3 small">
                    <div class="text-muted mb-1">Payment Method:</div>
                    <div class="fw-semibold text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-credit-card text-muted"></i>
                        <span>@Model.Order.PaymentMethod</span>
                    </div>
                </div>

                @if (Model.Order.OrderStatus == "Pending" || Model.Order.OrderStatus == "Confirmed" || Model.Order.OrderStatus == "Processing")
                {
                    <div class="border-top pt-3">
                        <form asp-action="CancelOrder" asp-route-id="@Model.Order.OrderId" method="post" onsubmit="return confirm('Are you sure you want to cancel this order? This action cannot be reversed.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100 btn-sm py-2 d-inline-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-x-circle"></i>
                                <span>Cancel Order</span>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>