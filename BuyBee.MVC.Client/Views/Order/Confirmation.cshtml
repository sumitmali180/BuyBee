@model EMart.ViewModels.OrderConfirmationVM

@{
    ViewData["Title"] = "Order Confirmed - Buybee";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border p-4 p-md-5 text-center bg-white shadow-sm">
                <!-- Success Emblem -->
                <div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success p-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-check2-circle display-5"></i>
                </div>

                <h1 class="h2 fw-bold text-dark mb-2">Order Confirmed!</h1>
                <p class="text-muted mb-4">
                    Thank you for shopping with <strong>Buybee</strong>. Your order has been placed and is being prepared for dispatch.
                </p>

                <!-- Order Meta Grid -->
                <div class="bg-light rounded-3 p-4 mb-4 text-start border">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted small text-uppercase fw-semibold">Order Number</span>
                            <div class="fw-bold fs-6 text-dark mt-1">@Model.Order.OrderNumber</div>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted small text-uppercase fw-semibold">Order Date & Time</span>
                            <div class="fw-bold fs-6 text-dark mt-1">@Model.Order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted small text-uppercase fw-semibold">Payment Method</span>
                            <div class="fw-bold fs-6 text-dark mt-1">@Model.Order.PaymentMethod</div>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted small text-uppercase fw-semibold">Order Status</span>
                            <div class="mt-1">
                                <span class="badge bg-warning text-dark">@Model.Order.OrderStatus</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delivery Address Box -->
                @if (Model.Address != null)
                {
                    <div class="text-start border rounded-3 p-3 mb-4 bg-white">
                        <h2 class="h6 fw-bold mb-2 text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt text-warning"></i> Shipping Destination
                        </h2>
                        <div class="small text-secondary">
                            <div>@Model.Address.AddressLine1</div>
                            <div>@Model.Address.City, @Model.Address.State - @Model.Address.Pincode</div>
                            <div>India</div>
                        </div>
                    </div>
                }

                <!-- Total -->
                <div class="d-flex justify-content-between align-items-baseline border-top pt-3 mb-4">
                    <span class="fw-bold fs-5 text-dark">Total Paid / Payable</span>
                    <span class="display-6 fw-bold text-dark" style="font-size: 1.8rem;">
                        ₹@Model.Order.GrandTotal.ToString("N2")
                    </span>
                </div>

                <!-- Actions -->
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <a asp-area=""
                       asp-controller="Order"
                       asp-action="Details"
                       asp-route-id="@Model.Order.OrderId"
                       class="btn btn-warning btn-lg fw-bold text-dark shadow-sm">
                        <i class="bi bi-box-seam me-1"></i> Track Order Details
                    </a>

                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-house me-1"></i> Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>