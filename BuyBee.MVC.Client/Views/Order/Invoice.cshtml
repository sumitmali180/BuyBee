@model EMart.ViewModels.OrderVM

@{
    ViewData["Title"] = "Tax Invoice #" + Model.Order.OrderNumber;
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal subtotal = Model.Order.SubTotal;
    decimal discount = Model.Order.DiscountAmount;
    decimal grandTotal = Model.Order.GrandTotal;
    // Calculate 18% GST component (9% CGST + 9% SGST) from the taxable subtotal
    decimal taxableValue = Math.Round(subtotal / 1.18m, 2);
    decimal totalGst = subtotal - taxableValue;
    decimal cgst = Math.Round(totalGst / 2m, 2);
    decimal sgst = totalGst - cgst;
}

<div class="container py-4 py-md-5">
    <!-- Action Bar (Hidden on Print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <a asp-action="Details" asp-route-id="@Model.Order.OrderId" class="btn btn-outline-secondary btn-sm px-3 d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Order Details</span>
        </a>

        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-warning btn-sm px-4 fw-bold text-dark d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-printer-fill"></i>
                <span>Print Tax Invoice</span>
            </button>
        </div>
    </div>

    <!-- Printable Invoice Sheet -->
    <div class="card border shadow-sm rounded-4 p-4 p-md-5 invoice-sheet bg-white text-dark">
        <!-- Header -->
        <div class="row align-items-center border-bottom pb-4 mb-4">
            <div class="col-sm-6">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <img src="~/images/buybee-logo-full.png" asp-append-version="true" alt="Buybee" style="height: 40px; width: auto;" onerror="this.src='/images/buybee-logo-full.png'" />
                </div>
                <p class="text-muted mb-0 small">Buybee Retail & Direct Marketplace Pvt. Ltd.</p>
                <div class="small text-muted mt-2">
                    <strong>GSTIN:</strong> 27AABCU9603R1ZM<br />
                    <strong>Registered Address:</strong> BKC Business Park, Bandra East, Mumbai, MH - 400051<br />
                    <strong>Customer Support:</strong> support@buybee.com | +91 9876543210
                </div>
            </div>
            <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                <span class="badge bg-warning text-dark text-uppercase px-3 py-2 fw-bold tracking-wider mb-2">
                    ORIGINAL TAX INVOICE
                </span>
                <div class="text-dark small"><strong>Invoice Number:</strong> INV-@Model.Order.OrderNumber</div>
                <div class="text-muted small"><strong>Order Ref:</strong> #@Model.Order.OrderNumber</div>
                <div class="text-muted small"><strong>Date:</strong> @Model.Order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                <div class="text-muted small mt-1">
                    <strong>Status:</strong>
                    @if (Model.Order.OrderStatus == "Delivered")
                    {
                        <span class="bb-badge bb-badge-emerald px-2 py-0">Delivered</span>
                    }
                    else if (Model.Order.OrderStatus == "Cancelled")
                    {
                        <span class="bb-badge bb-badge-rose px-2 py-0">Cancelled</span>
                    }
                    else
                    {
                        <span class="bb-badge bb-badge-amber px-2 py-0">@Model.Order.OrderStatus</span>
                    }
                </div>
            </div>
        </div>

        <!-- Bill To / Payment Details -->
        <div class="row mb-4">
            <div class="col-sm-6">
                <h6 class="text-uppercase fw-bold text-muted small mb-2 border-bottom pb-1">Billed and Shipped To:</h6>
                @if (Model.Address != null)
                {
                    <div class="fw-bold text-dark">Customer Delivery Destination</div>
                    <div class="text-secondary small">@Model.Address.AddressLine1</div>
                    <div class="text-secondary small">@Model.Address.City, @Model.Address.State, PIN: @Model.Address.Pincode</div>
                    <div class="text-secondary small">Country: India</div>
                }
                else
                {
                    <div class="text-muted fst-italic small">Default Customer Delivery Address</div>
                }
            </div>
            <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                <h6 class="text-uppercase fw-bold text-muted small mb-2 border-bottom pb-1">Payment Summary:</h6>
                <div class="text-secondary small"><strong>Payment Method:</strong> @Model.Order.PaymentMethod</div>
                <div class="text-secondary small"><strong>Payment Status:</strong> @(Model.Order.PaymentMethod == "COD" ? "Cash on Delivery (Pending)" : "Confirmed / Paid Online")</div>
                <div class="text-secondary small"><strong>Place of Supply:</strong> Maharashtra (27)</div>
            </div>
        </div>

        <!-- Line Items Table with GST Breakdown -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th style="width: 40px;" class="text-center py-2">#</th>
                        <th class="py-2">Item Description</th>
                        <th style="width: 90px;" class="text-center py-2">HSN</th>
                        <th style="width: 60px;" class="text-center py-2">Qty</th>
                        <th style="width: 100px;" class="text-end py-2">Unit Price</th>
                        <th style="width: 110px;" class="text-end py-2">Taxable Value</th>
                        <th style="width: 90px;" class="text-end py-2">CGST (9%)</th>
                        <th style="width: 90px;" class="text-end py-2">SGST (9%)</th>
                        <th style="width: 120px;" class="text-end py-2">Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var item in Model.OrderDetails)
                    {
                        var itemTaxable = Math.Round(item.Total / 1.18m, 2);
                        var itemGst = item.Total - itemTaxable;
                        var itemCgst = Math.Round(itemGst / 2m, 2);
                        var itemSgst = itemGst - itemCgst;
                        <tr>
                            <td class="text-center text-muted small">@idx</td>
                            <td>
                                <div class="fw-semibold text-dark">@item.ProductName</div>
                                <small class="text-muted">Item Ref: #@item.ProductId</small>
                            </td>
                            <td class="text-center text-muted font-monospace small">84713010</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end text-muted">₹@item.UnitPrice.ToString("N2")</td>
                            <td class="text-end text-dark">₹@itemTaxable.ToString("N2")</td>
                            <td class="text-end text-muted small">₹@itemCgst.ToString("N2")</td>
                            <td class="text-end text-muted small">₹@itemSgst.ToString("N2")</td>
                            <td class="text-end fw-bold text-dark">₹@item.Total.ToString("N2")</td>
                        </tr>
                        idx++;
                    }
                </tbody>
            </table>
        </div>

        <!-- Summary Totals -->
        <div class="row justify-content-between mb-4">
            <div class="col-md-6 col-sm-12 mb-3 mb-md-0">
                <div class="p-3 bg-light rounded-3 border small">
                    <div class="fw-bold text-dark mb-1">Invoice Notes:</div>
                    <div class="text-muted">
                        All values inclusive of Goods and Services Tax (GST) as applicable under Central and State tax laws. For warranty or returns within 7 days, present this invoice.
                    </div>
                </div>
            </div>
            <div class="col-md-5 col-sm-12">
                <div class="d-flex justify-content-between py-1 border-bottom small">
                    <span class="text-muted">Taxable Subtotal:</span>
                    <span class="fw-semibold text-dark">₹@taxableValue.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom small">
                    <span class="text-muted">CGST (9%):</span>
                    <span class="text-dark">₹@cgst.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom small">
                    <span class="text-muted">SGST (9%):</span>
                    <span class="text-dark">₹@sgst.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom small">
                    <span class="text-muted">Total Tax (GST 18%):</span>
                    <span class="fw-semibold text-dark">₹@totalGst.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom small">
                    <span class="text-muted">Shipping Charges:</span>
                    <span class="text-success fw-semibold">FREE</span>
                </div>
                @if (discount > 0)
                {
                    <div class="d-flex justify-content-between py-1 border-bottom small text-danger">
                        <span>Promo Discount @(!string.IsNullOrEmpty(Model.Order.CouponCode) ? $"({Model.Order.CouponCode})" : ""):</span>
                        <span class="fw-bold">-₹@discount.ToString("N2")</span>
                    </div>
                }
                @if (Model.Order.CoinsRedeemed > 0)
                {
                    <div class="d-flex justify-content-between py-1 border-bottom small text-warning-emphasis">
                        <span>BeeCoins Redeemed (@Model.Order.CoinsRedeemed coins):</span>
                        <span class="fw-bold">-₹@Model.Order.CoinsDiscount.ToString("N2")</span>
                    </div>
                }
                <div class="d-flex justify-content-between py-2 border-bottom bg-warning bg-opacity-10 px-2 rounded-2 mt-2">
                    <span class="fw-bold text-dark fs-6">Grand Total:</span>
                    <span class="fw-bold fs-5 text-dark">₹@grandTotal.ToString("N2")</span>
                </div>
                @if (Model.Order.CoinsEarned > 0)
                {
                    <div class="d-flex justify-content-between py-1 small text-success fw-semibold">
                        <span>BeeCoins Cashback Earned:</span>
                        <span>+@Model.Order.CoinsEarned Coins</span>
                    </div>
                }
            </div>
        </div>

        <!-- Terms and Conditions & Signature -->
        <div class="row align-items-end mt-4 pt-3 border-top">
            <div class="col-sm-7 text-muted" style="font-size: 0.78rem;">
                <strong>Terms and Conditions:</strong><br />
                1. Goods once sold can be returned or exchanged within 7 days in original condition.<br />
                2. Computer-generated digital GST invoice valid without physical signature.<br />
                Thank you for choosing Buybee!
            </div>
            <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
                <div class="text-muted small mb-1">Buybee Marketplace Pvt. Ltd.</div>
                <div class="fw-bold text-dark font-monospace">[DIGITALLY VERIFIED]</div>
                <div class="text-muted small">Authorized Signatory</div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        header, footer, .no-print, #btnTop, .toast-container {
            display: none !important;
        }
        body {
            background-color: #fff !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .container {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
        }
        .invoice-sheet {
            box-shadow: none !important;
            border: none !important;
            padding: 10px !important;
        }
    }
</style>
