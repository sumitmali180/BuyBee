@model BuyBee.MVC.Client.ViewModels.VendorOrderListViewModel

@{
    ViewData["Title"] = "Customer Orders";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Customer Orders</h1>
            <p class="text-muted small mb-0">Track and fulfill line items ordered from your merchant store.</p>
        </div>
        <div>
            <span class="badge bg-indigo text-white rounded-pill px-3 py-2 fw-semibold" style="background-color: #4f46e5;">
                <i class="bi bi-box2-heart me-1"></i> @Model.TotalCount Order(s)
            </span>
        </div>
    </div>

    <!-- Filter Tabs Card -->
    <div class="vendor-card p-3 mb-4">
        <div class="d-flex flex-wrap gap-2">
            <a asp-area="Vendor" asp-controller="Orders" asp-action="Index"
               class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "All" ? "btn-dark" : "btn-light text-muted border")">
                All Orders
            </a>
            <a asp-area="Vendor" asp-controller="Orders" asp-action="Index" asp-route-statusFilter="Active"
               class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "Active" ? "btn-primary" : "btn-light text-muted border")">
                <i class="bi bi-clock-history me-1"></i> Active / Unfulfilled
            </a>
            <a asp-area="Vendor" asp-controller="Orders" asp-action="Index" asp-route-statusFilter="Pending"
               class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "Pending" ? "btn-warning text-dark" : "btn-light text-muted border")">
                Pending
            </a>
            <a asp-area="Vendor" asp-controller="Orders" asp-action="Index" asp-route-statusFilter="Packed"
               class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "Packed" ? "btn-info text-dark" : "btn-light text-muted border")">
                Packed
            </a>
            <a asp-area="Vendor" asp-controller="Orders" asp-action="Index" asp-route-statusFilter="Shipped"
               class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "Shipped" ? "btn-secondary" : "btn-light text-muted border")">
                Shipped
            </a>
            <a asp-area="Vendor" asp-controller="Orders" asp-action="Index" asp-route-statusFilter="Delivered"
               class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "Delivered" ? "btn-success" : "btn-light text-muted border")">
                Delivered
            </a>
        </div>
    </div>

    <!-- Orders Table Card -->
    <div class="vendor-card overflow-hidden">
        @if (Model.Orders == null || !Model.Orders.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-cart-x fs-1 text-muted d-block mb-2"></i>
                <h5 class="fw-bold text-dark mb-1">No orders found</h5>
                <p class="small mb-0">No customer orders match your current filter.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Order Number</th>
                            <th>Date</th>
                            <th>Customer & Destination</th>
                            <th>Payment</th>
                            <th>Your Items</th>
                            <th>Your Subtotal</th>
                            <th>Item Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Orders)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark d-block">@o.OrderNumber</span>
                                    <span class="badge bg-light text-muted border" style="font-size: 0.72rem;">#@o.OrderId</span>
                                </td>
                                <td class="small text-muted">
                                    @o.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                                </td>
                                <td>
                                    <span class="fw-medium text-dark d-block">@o.CustomerName</span>
                                    <span class="text-muted small">
                                        <i class="bi bi-geo-alt"></i> @(o.City ?? "—"), @(o.State ?? "—")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border small">@o.PaymentMethod</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold px-2 py-1">
                                        @o.VendorItemCount items
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-indigo" style="color: #4f46e5;">₹@o.VendorTotal.ToString("N2")</span>
                                </td>
                                <td>
                                    @{
                                        string badgeClass = o.ItemStatusSummary switch
                                        {
                                            "Delivered" => "bg-success text-white",
                                            "Shipped" => "bg-info text-dark",
                                            "Packed" => "bg-primary text-white",
                                            "Processing" => "bg-warning text-dark",
                                            _ => "bg-secondary text-white"
                                        };
                                    }
                                    <span class="badge @badgeClass rounded-pill px-2 py-1 small">
                                        @o.ItemStatusSummary
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        <a asp-area="Vendor" asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderId" class="btn btn-sm btn-outline-secondary rounded-2">
                                            <i class="bi bi-eye me-1"></i> Fulfill
                                        </a>
                                        <a asp-area="Vendor" asp-controller="Orders" asp-action="PackingSlip" asp-route-id="@o.OrderId" target="_blank" class="btn btn-sm btn-light border rounded-2" title="Print Packing Slip">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
