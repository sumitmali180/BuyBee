@model BuyBee.MVC.Client.ViewModels.VendorOrderDetailsViewModel

@{
    ViewData["Title"] = "Packing Slip - " + Model.OrderNumber;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Packing Slip - @Model.OrderNumber</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .packing-slip {
            max-width: 800px;
            margin: 20px auto;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            padding: 40px;
            border-radius: 8px;
        }
        @@media print {
            body {
                background: #ffffff;
                margin: 0;
                padding: 0;
            }
            .packing-slip {
                border: none;
                padding: 0;
                margin: 0;
                max-width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="container py-3 no-print text-center">
        <button onclick="window.print()" class="btn btn-primary px-4 fw-bold shadow-sm" style="background-color: #4f46e5; border-color: #4f46e5;">
            <i class="bi bi-printer me-1"></i> Print Packing Slip
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary px-3 ms-2">
            Close Window
        </button>
    </div>

    <div class="packing-slip shadow-sm">
        <!-- Store Header -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
            <div>
                <h2 class="h4 fw-bold text-dark mb-1">@ViewBag.StoreName</h2>
                <div class="text-muted small">
                    <span>Authorized Merchant &bull; Buybee Marketplace</span><br />
                    <span>Email: @ViewBag.ContactEmail</span><br />
                    <span>GSTIN: <code>@(string.IsNullOrEmpty(ViewBag.GstNumber) ? "NOT REGISTERED" : ViewBag.GstNumber)</code></span>
                </div>
            </div>
            <div class="text-end">
                <div class="badge bg-dark text-white text-uppercase px-3 py-2 fs-6 mb-2">MERCHANT PACKING SLIP</div>
                <div class="fw-bold fs-5 text-dark">@Model.OrderNumber</div>
                <div class="text-muted small">Date: @Model.OrderDate.ToString("dd MMM yyyy")</div>
            </div>
        </div>

        <!-- Ship To & Shipping Details -->
        <div class="row g-4 mb-4">
            <div class="col-6">
                <div class="p-3 bg-light rounded-3 border">
                    <h6 class="fw-bold text-dark text-uppercase small mb-2 text-muted">Ship To:</h6>
                    <div class="fw-bold text-dark">@Model.CustomerName</div>
                    <div class="text-muted small">
                        @(Model.AddressLine1 ?? "Shipping Address")<br />
                        @Model.City, @Model.State - @Model.Pincode<br />
                        <strong>Phone:</strong> @Model.CustomerPhoneMasked (Protected for Privacy)
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <h6 class="fw-bold text-dark text-uppercase small mb-2 text-muted">Logistics Details:</h6>
                    <div class="small text-muted">
                        <div><strong>Carrier:</strong> @(Model.CarrierName ?? "Buybee Express")</div>
                        <div><strong>Tracking AWB:</strong> <code>@(Model.TrackingNumber ?? "Awaiting Pickup")</code></div>
                        <div><strong>Payment Method:</strong> @Model.PaymentMethod</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <table class="table table-bordered align-middle mb-4">
            <thead class="table-light text-uppercase small text-muted">
                <tr>
                    <th style="width: 60px;">#</th>
                    <th>Item Description</th>
                    <th class="text-center" style="width: 100px;">Qty</th>
                    <th class="text-end" style="width: 140px;">Unit Price</th>
                    <th class="text-end" style="width: 140px;">Total</th>
                </tr>
            </thead>
            <tbody>
                @{ int counter = 1; }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">@counter</td>
                        <td>
                            <strong class="text-dark d-block">@item.ProductName</strong>
                            <span class="text-muted small">Product ID: #@item.ProductId</span>
                        </td>
                        <td class="text-center fw-bold">@item.Quantity</td>
                        <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                        <td class="text-end fw-bold">₹@item.Total.ToString("N2")</td>
                    </tr>
                    counter++;
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end fw-bold">Subtotal:</td>
                    <td class="text-end fw-bold">₹@Model.VendorSubtotal.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <!-- Sign-off Block -->
        <div class="row pt-4 border-top">
            <div class="col-6 text-muted small">
                <p class="mb-1"><strong>Packing Instructions:</strong></p>
                <ul class="ps-3 mb-0">
                    <li>Verify contents against this manifest before sealing package.</li>
                    <li>Affix Buybee Express shipping label securely to exterior carton.</li>
                </ul>
            </div>
            <div class="col-6 text-end">
                <div class="text-muted small mb-4">Packed & Verified by:</div>
                <div class="border-bottom d-inline-block" style="width: 180px;"></div>
                <div class="text-muted small mt-1">Authorized Signature</div>
            </div>
        </div>
    </div>
</body>
</html>
