@model BuyBee.MVC.Client.ViewModels.VendorLoginViewModel

@{
    ViewData["Title"] = "Merchant Vendor Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Buybee Merchant Hub - Vendor Portal</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --vendor-primary: #4f46e5;
            --vendor-primary-hover: #4338ca;
            --vendor-dark: #1e1b4b;
            --vendor-bg: #0f172a;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
            min-height: 100vh;
        }
        .vendor-login-card {
            border-radius: 1.25rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        .badge-vendor {
            background-color: #e0e7ff;
            color: #3730a3;
            font-weight: 700;
            letter-spacing: 0.05em;
        }
        .btn-vendor {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: #ffffff;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-vendor:hover {
            background: linear-gradient(135deg, #4338ca 0%, #4f46e5 100%);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.4);
        }
        .glow-icon {
            box-shadow: 0 0 25px rgba(79, 70, 229, 0.35);
        }
    </style>
</head>

<body class="d-flex align-items-center justify-content-center p-3">
    <div class="container" style="max-width: 450px;">
        <div class="vendor-login-card bg-white p-4 p-sm-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-indigo rounded-circle mb-3 glow-icon" style="width: 68px; height: 68px; background-color: #e0e7ff; color: #4338ca;">
                    <i class="bi bi-shop-window fs-1"></i>
                </div>
                <div class="d-block mb-2">
                    <span class="badge badge-vendor px-3 py-1 rounded-pill text-uppercase small">
                        <i class="bi bi-patch-check-fill me-1"></i> Buybee Merchant Network
                    </span>
                </div>
                <h1 class="h4 fw-bold text-dark mb-1">Vendor Portal</h1>
                <p class="text-muted small mb-0">Manage products, live orders, inventory & settlements</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div class="alert alert-danger p-3 small rounded-3 mb-3 d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-danger flex-shrink-0 mt-1"></i>
                    <div>@Html.ValidationSummary(true)</div>
                </div>
            }

            <form asp-area="Vendor"
                  asp-controller="Account"
                  asp-action="Login"
                  asp-route-returnUrl="@ViewBag.ReturnUrl"
                  method="post"
                  id="vendorLoginForm">
                @Html.AntiForgeryToken()

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control rounded-3" id="vendorEmail" placeholder="vendor@buybee.com" autocomplete="email" required />
                    <label asp-for="Email"><i class="bi bi-envelope me-1"></i> Merchant Email</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control rounded-3" id="vendorPassword" type="password" placeholder="Password" autocomplete="current-password" required />
                    <label asp-for="Password"><i class="bi bi-key me-1"></i> Password</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe">
                        <label class="form-check-label small text-muted" for="rememberMe">
                            Remember for 14 days
                        </label>
                    </div>
                    <span class="text-muted small"><i class="bi bi-shield-lock-fill text-indigo me-1"></i> SSL Secured</span>
                </div>

                <button type="submit" class="btn btn-vendor w-100 py-3 fw-bold rounded-3 shadow-sm d-inline-flex align-items-center justify-content-center gap-2 mt-1">
                    <i class="bi bi-box-arrow-in-right fs-5"></i>
                    <span>Access Merchant Dashboard</span>
                </button>
            </form>

            <!-- Quick fill helper for testing / demonstration -->
            <div class="mt-4 pt-3 border-top text-center">
                <button type="button" class="btn btn-sm btn-outline-indigo rounded-pill px-3" style="border-color: #c7d2fe; color: #4338ca;" onclick="fillTestVendor()">
                    <i class="bi bi-magic me-1"></i> Demo Fill: TechZone Electronics
                </button>
                <div class="text-muted small mt-2">
                    <code>vendor@buybee.com</code> / <code>Password@123</code>
                </div>
            </div>

            <div class="text-center mt-3">
                <a href="/" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Buybee Storefront
                </a>
            </div>
        </div>
    </div>

    <script>
        function fillTestVendor() {
            document.getElementById('vendorEmail').value = 'vendor@buybee.com';
            document.getElementById('vendorPassword').value = 'Password@123';
        }
    </script>
</body>
</html>
