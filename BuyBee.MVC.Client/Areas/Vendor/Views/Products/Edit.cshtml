@model BuyBee.MVC.Client.ViewModels.VendorProductFormViewModel

@{
    ViewData["Title"] = "Edit Product - " + Model.ProductName;
}

<div class="container-fluid px-0" style="max-width: 900px;">
    <!-- Breadcrumb -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-area="Vendor" asp-controller="Products" asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Products
        </a>
        <a href="/Product/Details/@Model.ProductId" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-box-arrow-up-right me-1"></i> View on Live Store
        </a>
    </div>

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Edit Product #@Model.ProductId</h1>
            <p class="text-muted small mb-0">Update pricing, description, stock levels, or manage image assets.</p>
        </div>
        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 small fw-semibold">
            <i class="bi bi-check-circle-fill me-1"></i> @Model.ApprovalStatus
        </span>
    </div>

    <!-- Form Card -->
    <div class="vendor-card p-4 p-md-5 mb-4">
        <form asp-area="Vendor" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div class="alert alert-danger p-3 small rounded-3 mb-4">
                    @Html.ValidationSummary(true)
                </div>
            }

            <!-- 1. Basic Info -->
            <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">1. Basic Information</h5>
            
            <div class="mb-3">
                <label asp-for="ProductName" class="form-label fw-semibold small">Product Name <span class="text-danger">*</span></label>
                <input asp-for="ProductName" class="form-control" required />
                <span asp-validation-for="ProductName" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label asp-for="CategoryId" class="form-label fw-semibold small">Category <span class="text-danger">*</span></label>
                    <select asp-for="CategoryId" class="form-select" asp-items="@Model.Categories" required>
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="SubCategoryId" class="form-label fw-semibold small">Sub Category</label>
                    <select asp-for="SubCategoryId" class="form-select" asp-items="@Model.SubCategories">
                        <option value="">-- Select Sub Category --</option>
                    </select>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="BrandId" class="form-label fw-semibold small">Brand</label>
                    <select asp-for="BrandId" class="form-select" asp-items="@Model.Brands">
                        <option value="">-- Select Brand --</option>
                    </select>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="UnitId" class="form-label fw-semibold small">Unit of Measure</label>
                    <select asp-for="UnitId" class="form-select" asp-items="@Model.Units">
                        <option value="">-- Select Unit --</option>
                    </select>
                </div>
            </div>

            <!-- 2. Pricing & Inventory -->
            <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">2. Pricing & Stock</h5>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <label asp-for="Price" class="form-label fw-semibold small">Selling Price (₹) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" required />
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Quantity" class="form-label fw-semibold small">Stock Quantity <span class="text-danger">*</span></label>
                    <input asp-for="Quantity" type="number" min="0" class="form-control" required />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="LowStockThreshold" class="form-label fw-semibold small">Low Stock Threshold</label>
                    <input asp-for="LowStockThreshold" type="number" min="1" class="form-control" />
                    <span class="text-muted" style="font-size: 0.72rem;">Alert triggers when stock drops below this number</span>
                </div>
            </div>

            <!-- 3. Description -->
            <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">3. Description & Details</h5>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-semibold small">Product Description</label>
                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
            </div>

            <!-- 4. Existing Images -->
            <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">4. Existing Product Images</h5>

            @if (Model.ExistingImages != null && Model.ExistingImages.Any())
            {
                <div class="d-flex flex-wrap gap-3 mb-4">
                    @foreach (var img in Model.ExistingImages)
                    {
                        <div class="position-relative border rounded-3 p-1 bg-light" style="width: 110px;">
                            <img src="@img.ImagePath" alt="Product photo" class="w-100 rounded-2 object-fit-cover" style="height: 90px;" onerror="this.src='/images/product-placeholder.png'" />
                            <form asp-area="Vendor" asp-controller="Products" asp-action="DeleteImage" method="post" class="position-absolute top-0 end-0 m-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="imageId" value="@img.ImageId" />
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <button type="submit" class="btn btn-danger btn-sm p-1 rounded-circle lh-1" title="Delete Image" onclick="return confirm('Remove this image?');">
                                    <i class="bi bi-trash" style="font-size: 0.75rem;"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-4">No gallery images uploaded yet for this product.</p>
            }

            <!-- Upload Additional Images -->
            <div class="mb-4">
                <label asp-for="Images" class="form-label fw-semibold small">Add More Images</label>
                <input asp-for="Images" type="file" multiple class="form-control" accept="image/*" />
            </div>

            <!-- 5. Visibility -->
            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch">
                <label class="form-check-label fw-semibold small" for="isActiveSwitch">
                    Active on Storefront (Customers can discover and purchase)
                </label>
            </div>

            <!-- Buttons -->
            <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                <a asp-area="Vendor" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary px-4">
                    Cancel
                </a>
                <button type="submit" class="btn btn-vendor px-5 py-2">
                    <i class="bi bi-save me-1"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
