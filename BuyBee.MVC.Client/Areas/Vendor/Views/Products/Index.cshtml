@model BuyBee.MVC.Client.ViewModels.VendorProductListViewModel

@{
    ViewData["Title"] = "Products Catalog";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Products Catalog</h1>
            <p class="text-muted small mb-0">Manage all products listed by your merchant store on the Buybee marketplace.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-area="Vendor" asp-controller="Products" asp-action="Create" class="btn btn-vendor shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                <span>Add New Product</span>
            </a>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="vendor-card p-3 mb-4">
        <form method="get" asp-area="Vendor" asp-controller="Products" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search product name or SKU..." />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="categoryId" class="form-select form-select-sm" asp-items="@Model.Categories">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="stockFilter" class="form-select form-select-sm">
                    <option value="ALL" selected="@(Model.StockFilter == "ALL")">All Stock</option>
                    <option value="LOW" selected="@(Model.StockFilter == "LOW")">Low Stock Only</option>
                    <option value="OUT" selected="@(Model.StockFilter == "OUT")">Out of Stock</option>
                    <option value="IN" selected="@(Model.StockFilter == "IN")">In Stock</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-dark flex-grow-1">Filter</button>
                <a asp-area="Vendor" asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Products Table Card -->
    <div class="vendor-card overflow-hidden">
        @if (Model.Products == null || !Model.Products.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-box-seam fs-1 text-muted d-block mb-2"></i>
                <h5 class="fw-bold text-dark mb-1">No products found in catalog</h5>
                <p class="small mb-3">You haven't added any products or none match your filter criteria.</p>
                <a asp-area="Vendor" asp-controller="Products" asp-action="Create" class="btn btn-vendor btn-sm rounded-pill px-4">
                    <i class="bi bi-plus-lg me-1"></i> Add Your First Product
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th style="min-width: 260px;">Product Name</th>
                            <th>Category</th>
                            <th>Brand</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Approval</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Products)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(p.PrimaryImage) ? "/images/product-placeholder.png" : p.PrimaryImage)" 
                                             alt="@p.ProductName" 
                                             class="rounded-3 object-fit-cover border" 
                                             style="width: 50px; height: 50px;" 
                                             onerror="this.src='/images/product-placeholder.png'" />
                                        <div>
                                            <a asp-area="Vendor" asp-controller="Products" asp-action="Edit" asp-route-id="@p.ProductId" class="fw-bold text-dark text-decoration-none">
                                                @p.ProductName
                                            </a>
                                            <span class="text-muted small d-block">
                                                ID: #@p.ProductId &bull; @p.ImageCount @(p.ImageCount == 1 ? "image" : "images")
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(p.CategoryName ?? "General")</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@(string.IsNullOrEmpty(p.BrandName) ? "—" : p.BrandName)</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">₹@p.Price.ToString("N2")</span>
                                </td>
                                <td>
                                    @if (p.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger rounded-pill px-2 py-1 small">Out of Stock</span>
                                    }
                                    else if (p.IsLowStock)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1 small">
                                            @p.StockQuantity left
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 small">
                                            @p.StockQuantity units
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 small">
                                        <i class="bi bi-check-circle me-1"></i> @p.ApprovalStatus
                                    </span>
                                </td>
                                <td>
                                    <form asp-area="Vendor" asp-controller="Products" asp-action="ToggleStatus" asp-route-id="@p.ProductId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm p-0 border-0" title="Click to toggle active status">
                                            @if (p.IsActive)
                                            {
                                                <span class="badge bg-success rounded-pill px-2 py-1"><i class="bi bi-toggle-on me-1"></i> Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary rounded-pill px-2 py-1"><i class="bi bi-toggle-off me-1"></i> Inactive</span>
                                            }
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        <a asp-area="Vendor" asp-controller="Products" asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-secondary rounded-2" title="Edit Product">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="/Product/Details/@p.ProductId" target="_blank" class="btn btn-sm btn-light border rounded-2" title="View on Customer Storefront">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
