@model BuyBee.MVC.Client.ViewModels.VendorProfileViewModel

@{
    ViewData["Title"] = "Store Profile & Settings";
}

<div class="container-fluid px-0" style="max-width: 900px;">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Store Profile & Settings</h1>
            <p class="text-muted small mb-0">Update your merchant store branding, business address, and banking details for automated settlements.</p>
        </div>
        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 small fw-semibold">
            <i class="bi bi-shield-check me-1"></i> Verified Merchant
        </span>
    </div>

    <!-- Profile Form Card -->
    <div class="vendor-card p-4 p-md-5">
        <form asp-area="Vendor" asp-controller="Profile" asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="VendorId" />

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div class="alert alert-danger p-3 small rounded-3 mb-4">
                    @Html.ValidationSummary(true)
                </div>
            }

            <!-- 1. Store Identity -->
            <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-shop text-primary"></i>
                <span>Store Identity</span>
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-8">
                    <label asp-for="StoreName" class="form-label fw-semibold small">Store Display Name <span class="text-danger">*</span></label>
                    <input asp-for="StoreName" class="form-control" required />
                    <span asp-validation-for="StoreName" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="StoreSlug" class="form-label fw-semibold small">Store URL Slug</label>
                    <input asp-for="StoreSlug" class="form-control bg-light text-muted" readonly />
                </div>

                <div class="col-12">
                    <label asp-for="StoreDescription" class="form-label fw-semibold small">Store Tagline / Description</label>
                    <textarea asp-for="StoreDescription" rows="2" class="form-control" placeholder="Brief summary of your product specialty and authorized dealership status..."></textarea>
                </div>
            </div>

            <!-- 2. Contact & Address -->
            <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-envelope-at text-info"></i>
                <span>Contact & Business Address</span>
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label asp-for="ContactEmail" class="form-label fw-semibold small">Support Email</label>
                    <input asp-for="ContactEmail" class="form-control" type="email" />
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="ContactPhone" class="form-label fw-semibold small">Support Phone</label>
                    <input asp-for="ContactPhone" class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="BusinessAddress" class="form-label fw-semibold small">Shop / Warehouse Address</label>
                    <input asp-for="BusinessAddress" class="form-control" placeholder="Shop/Suite number, street, landmark" />
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="City" class="form-label fw-semibold small">City</label>
                    <input asp-for="City" class="form-control" />
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="State" class="form-label fw-semibold small">State</label>
                    <input asp-for="State" class="form-control" />
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Pincode" class="form-label fw-semibold small">Pincode</label>
                    <input asp-for="Pincode" class="form-control" />
                </div>
            </div>

            <!-- 3. Tax Compliance & Banking -->
            <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-bank text-success"></i>
                <span>Tax Compliance & Banking Details</span>
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label asp-for="GstNumber" class="form-label fw-semibold small">GST Identification Number (GSTIN)</label>
                    <input asp-for="GstNumber" class="form-control text-uppercase" placeholder="e.g. 27AAACT1234F1Z5" />
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="PanNumber" class="form-label fw-semibold small">Permanent Account Number (PAN)</label>
                    <input asp-for="PanNumber" class="form-control text-uppercase" placeholder="e.g. AAACT1234F" />
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="BankAccountNumber" class="form-label fw-semibold small">Bank Account Number</label>
                    <input asp-for="BankAccountNumber" class="form-control" placeholder="12-18 digits" />
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="BankIfsc" class="form-label fw-semibold small">Bank IFSC Code</label>
                    <input asp-for="BankIfsc" class="form-control text-uppercase" placeholder="e.g. HDFC0001234" />
                </div>
            </div>

            <!-- 4. Platform Agreement -->
            <div class="p-3 bg-light rounded-3 border mb-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="fw-semibold text-dark small d-block">Platform Commercial Terms</span>
                    <span class="text-muted" style="font-size: 0.75rem;">Standard marketplace commission rate is managed by Buybee Platform Administration.</span>
                </div>
                <span class="badge bg-indigo text-white px-3 py-2 rounded-pill fw-bold" style="background-color: #4f46e5;">
                    @Model.CommissionRate% Commission
                </span>
            </div>

            <div class="d-flex justify-content-end pt-3 border-top">
                <button type="submit" class="btn btn-vendor px-5 py-2">
                    <i class="bi bi-check-lg me-1"></i> Update Store Profile
                </button>
            </div>
        </form>
    </div>
</div>
