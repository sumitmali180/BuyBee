@model BuyBee.MVC.Client.ViewModels.VendorReportsViewModel

@{
    ViewData["Title"] = "Sales & Settlement Reports";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Sales & Settlement Reports</h1>
            <p class="text-muted small mb-0">Transparent accounting of gross merchandise volume, platform commissions, and net merchant payouts.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-indigo text-white px-3 py-2 rounded-pill small fw-semibold" style="background-color: #4f46e5;">
                <i class="bi bi-percent me-1"></i> Commission: @Model.CommissionRate%
            </span>
        </div>
    </div>

    <!-- Date Range Filter Card -->
    <div class="vendor-card p-3 mb-4">
        <form method="get" asp-area="Vendor" asp-controller="Reports" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-sm-4 col-md-3">
                <label class="form-label text-muted small mb-1">From Date</label>
                <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-sm-4 col-md-3">
                <label class="form-label text-muted small mb-1">To Date</label>
                <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-sm-4 col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-dark w-100 py-1">
                    <i class="bi bi-funnel me-1"></i> Generate Report
                </button>
            </div>
            <div class="col-12 col-md-3 d-flex align-items-end justify-content-md-end gap-1">
                <a asp-area="Vendor" asp-controller="Reports" asp-action="Index" asp-route-startDate="@DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd")" class="btn btn-sm btn-light border py-1">7 Days</a>
                <a asp-area="Vendor" asp-controller="Reports" asp-action="Index" asp-route-startDate="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" class="btn btn-sm btn-light border py-1">30 Days</a>
                <a asp-area="Vendor" asp-controller="Reports" asp-action="Index" asp-route-startDate="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))" class="btn btn-sm btn-light border py-1">This Month</a>
            </div>
        </form>
    </div>

    <!-- Settlement Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="vendor-card p-3 p-md-4 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Gross Sales (GMV)</span>
                <h3 class="fw-bold text-dark mb-1">₹@Model.GrossSales.ToString("N2")</h3>
                <span class="text-muted small">Total customer billings</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="vendor-card p-3 p-md-4 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Platform Commission (@Model.CommissionRate%)</span>
                <h3 class="fw-bold text-danger mb-1">-₹@Model.PlatformCommission.ToString("N2")</h3>
                <span class="text-muted small">Buybee marketplace fee</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="vendor-card p-3 p-md-4 h-100" style="border-left: 4px solid #10b981;">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Net Merchant Settlement</span>
                <h3 class="fw-bold text-success mb-1">₹@Model.NetPayout.ToString("N2")</h3>
                <span class="text-muted small">Credited to registered bank</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="vendor-card p-3 p-md-4 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Volume</span>
                <h3 class="fw-bold text-dark mb-1">@Model.OrderCount Orders</h3>
                <span class="text-muted small">@Model.UnitsSold units sold</span>
            </div>
        </div>
    </div>

    <!-- Top Products and Daily Breakdown -->
    <div class="row g-4">
        <!-- Top Products -->
        <div class="col-12 col-lg-6">
            <div class="vendor-card p-4 h-100">
                <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                    <i class="bi bi-trophy text-warning"></i>
                    <span>Top Performing Products</span>
                </h5>

                @if (Model.TopProducts == null || !Model.TopProducts.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-bar-chart fs-1 d-block mb-2"></i>
                        <p class="small mb-0">No sales recorded during this period.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted small text-uppercase">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Units</th>
                                    <th class="text-end">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.TopProducts)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@(string.IsNullOrEmpty(p.ImagePath) ? "/images/product-placeholder.png" : p.ImagePath)" 
                                                     alt="@p.ProductName" 
                                                     class="rounded-2 object-fit-cover border" 
                                                     style="width: 36px; height: 36px;" 
                                                     onerror="this.src='/images/product-placeholder.png'" />
                                                <span class="fw-bold text-dark text-truncate" style="max-width: 220px;" title="@p.ProductName">
                                                    @p.ProductName
                                                </span>
                                            </div>
                                        </td>
                                        <td class="text-center fw-bold">@p.UnitsSold</td>
                                        <td class="text-end fw-bold text-indigo" style="color: #4f46e5;">
                                            ₹@p.TotalRevenue.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Daily Sales Curve -->
        <div class="col-12 col-lg-6">
            <div class="vendor-card p-4 h-100">
                <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-event text-primary"></i>
                    <span>Daily Sales Breakdown</span>
                </h5>

                @if (Model.DailySales == null || !Model.DailySales.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                        <p class="small mb-0">No daily order events recorded yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 350px;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light text-muted small text-uppercase sticky-top">
                                <tr>
                                    <th>Date</th>
                                    <th class="text-center">Orders</th>
                                    <th class="text-center">Units</th>
                                    <th class="text-end">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.DailySales.OrderByDescending(x => x.SaleDate))
                                {
                                    <tr>
                                        <td class="small fw-semibold text-dark">
                                            @d.SaleDate.ToString("dd MMM yyyy (ddd)")
                                        </td>
                                        <td class="text-center"><span class="badge bg-light text-dark border">@d.DailyOrders</span></td>
                                        <td class="text-center">@d.DailyUnits</td>
                                        <td class="text-end fw-bold text-dark">₹@d.DailyRevenue.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
