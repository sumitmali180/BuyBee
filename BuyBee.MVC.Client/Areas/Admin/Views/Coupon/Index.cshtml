@model IEnumerable<EMart.Models.Coupon>

@{
    ViewData["Title"] = "Coupons & Promo Codes Management";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-tag-fill text-warning me-2"></i>Coupons & Promotional Codes
            </h1>
            <p class="text-muted small mb-0">Create and manage marketing discounts, minimum order conditions, and usage caps</p>
        </div>
        <button type="button" class="btn btn-warning fw-semibold d-inline-flex align-items-center gap-2 text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#createCouponModal">
            <i class="bi bi-plus-lg"></i>
            <span>Create New Coupon</span>
        </button>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border shadow-sm rounded-3 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Total Promo Codes</span>
                        <h3 class="fw-bold mb-0 mt-1">@Model.Count()</h3>
                    </div>
                    <div class="rounded-circle bg-light p-3 text-warning fs-4">
                        <i class="bi bi-ticket-perforated-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border shadow-sm rounded-3 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Active Coupons</span>
                        <h3 class="fw-bold mb-0 mt-1 text-success">@Model.Count(c => c.IsActive)</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success fs-4">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border shadow-sm rounded-3 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Total Redemptions</span>
                        <h3 class="fw-bold mb-0 mt-1 text-primary">@Model.Sum(c => c.TimesUsed)</h3>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary fs-4">
                        <i class="bi bi-bag-check-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border shadow-sm rounded-3 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Percentage Deals</span>
                        <h3 class="fw-bold mb-0 mt-1 text-dark">@Model.Count(c => c.DiscountType == "Percentage")</h3>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning fs-4">
                        <i class="bi bi-percent"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Coupons Table Card -->
    <div class="card border shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">Configured Coupons</h5>
            <span class="badge bg-light text-dark border">@Model.Count() records</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Discount</th>
                        <th>Min Order</th>
                        <th>Max Cap</th>
                        <th>Usage</th>
                        <th>Expiry</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-warning text-dark font-monospace fs-6 px-2 py-1">
                                            @item.Code
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.DiscountType == "Percentage")
                                    {
                                        <span class="fw-bold text-dark">@item.DiscountValue.ToString("0")% OFF</span>
                                        <small class="text-muted d-block">Percentage</small>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-dark">₹@item.DiscountValue.ToString("N0") OFF</span>
                                        <small class="text-muted d-block">Flat Amount</small>
                                    }
                                </td>
                                <td>
                                    <span class="text-dark">₹@item.MinOrderAmount.ToString("N0")</span>
                                </td>
                                <td>
                                    @(item.MaxDiscount.HasValue ? "₹" + item.MaxDiscount.Value.ToString("N0") : "No limit")
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.TimesUsed</span>
                                    <span class="text-muted small">/ @(item.UsageLimit.HasValue ? item.UsageLimit.Value.ToString() : "∞")</span>
                                </td>
                                <td>
                                    @if (item.ExpiryDate.HasValue)
                                    {
                                        var isExpired = item.ExpiryDate.Value < DateTime.Now;
                                        <span class="@(isExpired ? "text-danger fw-semibold" : "text-dark") small">
                                            @item.ExpiryDate.Value.ToString("dd MMM yyyy")
                                        </span>
                                        @if (isExpired)
                                        {
                                            <span class="badge bg-danger ms-1" style="font-size: 10px;">Expired</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Never expires</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="Toggle" asp-route-id="@item.CouponId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm p-0 border-0" title="Click to toggle status">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">
                                                    <i class="bi bi-check-circle me-1"></i> Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-2 py-1">
                                                    <i class="bi bi-slash-circle me-1"></i> Disabled
                                                </span>
                                            }
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="Delete" asp-route-id="@item.CouponId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete coupon @item.Code?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm p-1 px-2" title="Delete Coupon">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-ticket-perforated fs-1 d-block mb-2 text-secondary"></i>
                                No promo codes created yet. Click "Create New Coupon" to set one up!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Coupon Modal -->
<div class="modal fade" id="createCouponModal" tabindex="-1" aria-labelledby="createCouponModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-dark text-white p-3">
                <h5 class="modal-title fw-bold" id="createCouponModalLabel">
                    <i class="bi bi-tag-fill text-warning me-2"></i>Create New Coupon
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Coupon Code <span class="text-danger">*</span></label>
                        <input type="text" name="Code" class="form-control text-uppercase font-monospace" placeholder="e.g. MEGA20, FESTIVE100" required maxlength="30" />
                        <small class="text-muted">Will automatically be converted to uppercase</small>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold">Discount Type <span class="text-danger">*</span></label>
                            <select name="DiscountType" class="form-select" required>
                                <option value="Percentage">Percentage (%)</option>
                                <option value="Fixed">Fixed Amount (₹)</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold">Discount Value <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0.01" name="DiscountValue" class="form-control" placeholder="e.g. 10 or 150" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold">Min Order Spend (₹)</label>
                            <input type="number" step="0.01" min="0" name="MinOrderAmount" class="form-control" value="0" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold">Max Discount Cap (₹)</label>
                            <input type="number" step="0.01" min="0" name="MaxDiscount" class="form-control" placeholder="Optional cap" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold">Expiry Date</label>
                            <input type="date" name="ExpiryDate" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold">Usage Limit</label>
                            <input type="number" min="1" name="UsageLimit" class="form-control" placeholder="e.g. 500 uses" />
                        </div>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="modalCouponActive" checked />
                        <label class="form-check-label small fw-semibold" for="modalCouponActive">Activate immediately</label>
                    </div>
                </div>
                <div class="modal-footer p-3 bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning btn-sm px-4 fw-bold text-dark">Save & Publish Coupon</button>
                </div>
            </form>
        </div>
    </div>
</div>
