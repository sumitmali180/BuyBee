@model EMart.Models.Roles

@{
    ViewData["Title"] = "Role Details - " + Model.RoleName;
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1 small text-muted">
                            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Roles</a></li>
                            <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Details</li>
                        </ol>
                    </nav>
                    <h1 class="h3 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge text-amber"></i>
                        <span>@Model.RoleName</span>
                    </h1>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.RoleId" class="btn btn-primary btn-sm px-3 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-pencil"></i>
                        <span>Edit</span>
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-arrow-left"></i>
                        <span>Back</span>
                    </a>
                </div>
            </div>

            <div class="bb-card p-4 p-md-5">
                <h2 class="h6 fw-bold text-uppercase text-muted tracking-wider mb-4 pb-2 border-bottom">
                    Role Specification
                </h2>

                <div class="d-flex flex-column gap-3">
                    <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Role ID</span>
                        <span class="fw-semibold text-dark font-monospace">#@Model.RoleId</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Role Name</span>
                        <span class="fw-bold text-dark">@Model.RoleName</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>