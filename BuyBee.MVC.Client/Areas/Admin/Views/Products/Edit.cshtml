@model EMart.ViewModels.ProductVM

@{
    ViewData["Title"] = "Edit Product " + Model.Product.ProductName;
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Catalog</a></li>
                    <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Edit Product</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square text-amber"></i>
                <span>Edit: @Model.Product.ProductName</span>
            </h1>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Products</span>
        </a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="Product.ProductId" type="hidden" />

        <div class="bb-card p-4 p-md-5 mb-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4"></div>

            <h2 class="h6 fw-bold text-uppercase text-muted tracking-wider mb-3">General Information</h2>

            <div class="row g-3 mb-4">
                <div class="col-md-12">
                    <div class="form-floating">
                        <input asp-for="Product.ProductName" class="form-control" placeholder="Enter Product Name" />
                        <label asp-for="Product.ProductName">Product Name *</label>
                        <span asp-validation-for="Product.ProductName" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <h2 class="h6 fw-bold text-uppercase text-muted tracking-wider mb-3">Classification & Categorization</h2>

            <div class="row g-3 mb-4">
                <div class="col-md-6 col-lg-3">
                    <label class="form-label small text-muted fw-semibold">Category *</label>
                    <select asp-for="Product.CategoryId"
                            asp-items="Model.Categories"
                            class="form-select"
                            id="CategoryId">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label small text-muted fw-semibold">Sub Category *</label>
                    <select asp-for="Product.SubCategoryId"
                            asp-items="Model.SubCategories"
                            class="form-select"
                            id="SubCategoryId">
                        <option value="">-- Select Sub Category --</option>
                    </select>
                    <span asp-validation-for="Product.SubCategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label small text-muted fw-semibold">Brand Partner *</label>
                    <select asp-for="Product.BrandId"
                            asp-items="Model.Brands"
                            class="form-select">
                        <option value="">-- Select Brand --</option>
                    </select>
                    <span asp-validation-for="Product.BrandId" class="text-danger small"></span>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label small text-muted fw-semibold">Measurement Unit *</label>
                    <select asp-for="Product.UnitId"
                            asp-items="Model.Units"
                            class="form-select">
                        <option value="">-- Select Unit --</option>
                    </select>
                    <span asp-validation-for="Product.UnitId" class="text-danger small"></span>
                </div>
            </div>

            <h2 class="h6 fw-bold text-uppercase text-muted tracking-wider mb-3">Pricing & Inventory</h2>

            <div class="row g-3 mb-4">
                <div class="col-md-6 col-lg-4">
                    <div class="form-floating">
                        <input asp-for="Product.Price" class="form-control" placeholder="0.00" type="number" step="0.01" />
                        <label asp-for="Product.Price">Price (₹) *</label>
                        <span asp-validation-for="Product.Price" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="form-floating">
                        <input asp-for="Product.Quantity" class="form-control" placeholder="0" type="number" />
                        <label asp-for="Product.Quantity">Stock Quantity *</label>
                        <span asp-validation-for="Product.Quantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-12 col-lg-4 d-flex align-items-center">
                    <div class="form-check form-switch p-3 bg-light rounded-3 w-100 ps-5">
                        <input asp-for="Product.IsActive" class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" />
                        <label class="form-check-label fw-semibold text-dark" for="flexSwitchCheckDefault">
                            Publish to Live Catalog
                        </label>
                    </div>
                </div>
            </div>

            <h2 class="h6 fw-bold text-uppercase text-muted tracking-wider mb-3">Product Description</h2>

            <div class="mb-4">
                <textarea asp-for="Product.Description" class="form-control" rows="5" placeholder="Enter comprehensive product details, specifications, and features..."></textarea>
                <span asp-validation-for="Product.Description" class="text-danger small"></span>
            </div>

            <h2 class="h6 fw-bold text-uppercase text-muted tracking-wider mb-3">Add Additional Photos</h2>

            <div class="p-3 bg-light rounded-3 mb-3 border">
                <label asp-for="Images" class="form-label fw-semibold text-dark mb-1">Select New Photos</label>
                <input asp-for="Images"
                       id="ImageUpload"
                       class="form-control"
                       type="file"
                       multiple
                       accept="image/*" />
                <span asp-validation-for="Images" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-4" id="imagePreview"></div>

            @if (Model.ProductImages != null && Model.ProductImages.Any())
            {
                <h2 class="h6 fw-bold text-uppercase text-muted tracking-wider mb-3 pt-3 border-top">Existing Product Photos</h2>

                <div class="row g-3">
                    @foreach (var image in Model.ProductImages)
                    {
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="bb-card p-2 text-center h-100 d-flex flex-column">
                                <img src="@image.ImagePath"
                                     class="rounded-2 object-fit-cover w-100 mb-2"
                                     style="height: 160px;" />
                                <div class="mt-auto">
                                    <button type="submit"
                                            asp-action="DeleteImage"
                                            name="imageId"
                                            value="@image.ImageId"
                                            formaction="/Admin/Products/DeleteImage?imageId=@image.ImageId&productId=@Model.Product.ProductId"
                                            class="btn btn-outline-danger btn-sm w-100 d-inline-flex align-items-center justify-content-center gap-1"
                                            onclick="return confirm('Delete this photo?');">
                                        <i class="bi bi-trash"></i>
                                        <span>Remove</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="d-flex justify-content-end gap-2 pb-5">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2">
                <i class="bi bi-check-lg"></i>
                <span>Update Product</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("ImageUpload").addEventListener("change", function () {
            let preview = document.getElementById("imagePreview");
            preview.innerHTML = "";

            Array.from(this.files).forEach(file => {
                if (!file.type.startsWith("image/")) return;
                let reader = new FileReader();
                reader.onload = function (e) {
                    preview.innerHTML += `
                        <div class="col-md-3 col-sm-6">
                            <div class="bb-card p-2 text-center">
                                <img src="${e.target.result}" class="rounded-2 object-fit-cover w-100 mb-2" style="height: 140px;">
                                <div class="small text-muted text-truncate">${file.name}</div>
                            </div>
                        </div>`;
                };
                reader.readAsDataURL(file);
            });
        });

        // Cascading SubCategories on Category change
        $("#CategoryId").change(function () {
            var categoryId = $(this).val();
            var subCategorySelect = $("#SubCategoryId");
            subCategorySelect.empty();
            subCategorySelect.append('<option value="">-- Select Sub Category --</option>');
            if (categoryId) {
                $.getJSON('/Admin/Products/GetSubCategoriesByCategory', { categoryId: categoryId }, function (data) {
                    $.each(data, function (index, item) {
                        subCategorySelect.append($('<option/>', {
                            value: item.value,
                            text: item.text
                        }));
                    });
                });
            }
        });
    </script>
}