@model IEnumerable<EMart.Models.Units>

@{
    ViewData["Title"] = "Measurement Units";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-rulers text-amber"></i>
                <span>Measurement Units</span>
            </h1>
            <p class="text-muted small mb-0">Manage catalog quantity metrics (e.g., Kg, Pcs, Litre, Pack)</p>
        </div>

        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Add Unit</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="bb-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th style="width: 80px;" class="ps-4 py-3">ID</th>
                        <th class="py-3">Unit Name</th>
                        <th class="py-3">Short Symbol</th>
                        <th class="py-3 text-center" style="width: 140px;">Status</th>
                        <th class="py-3">Created On</th>
                        <th class="pe-4 py-3 text-end" style="width: 160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3 font-monospace text-muted small">
                                    #@item.UnitId
                                </td>
                                <td class="py-3">
                                    <div class="fw-semibold text-dark">@item.UnitName</div>
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border font-monospace">@(string.IsNullOrEmpty(item.UnitShortName) ? "-" : item.UnitShortName)</span>
                                </td>
                                <td class="py-3 text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="bb-badge bb-badge-emerald px-2 py-0">Active</span>
                                    }
                                    else
                                    {
                                        <span class="bb-badge bb-badge-rose px-2 py-0">Inactive</span>
                                    }
                                </td>
                                <td class="py-3 small text-muted">
                                    @(item.CreatedOn?.ToString("dd MMM yyyy") ?? "-")
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.UnitId" class="btn btn-outline-secondary btn-sm p-1 px-2" title="Edit Unit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.UnitId" class="btn btn-outline-secondary btn-sm p-1 px-2" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.UnitId" class="btn btn-outline-danger btn-sm p-1 px-2" title="Delete Unit">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted small">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                                No measurement units registered.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
