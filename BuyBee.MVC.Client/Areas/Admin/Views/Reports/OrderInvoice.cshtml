@model EMart.ViewModels.OrderInvoiceViewModel

@{
    ViewData["Title"] = "Order Invoice Generator";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1 small text-muted">
                            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Reports</a></li>
                            <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Invoice</li>
                        </ol>
                    </nav>
                    <h1 class="h3 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-receipt text-amber"></i>
                        <span>Order Tax Invoice</span>
                    </h1>
                </div>

                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back</span>
                </a>
            </div>

            <div class="bb-card p-4 p-md-5">
                @if (Model?.Orders == null || !Model.Orders.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        No customer orders recorded to generate invoices for.
                    </div>
                }
                else
                {
                    <form asp-area="Admin"
                          asp-controller="Reports"
                          asp-action="OrderInvoiceReport"
                          method="get">

                        <div class="mb-4">
                            <label class="form-label small text-muted fw-semibold" for="orderId">
                                Select Order to Produce Tax Invoice *
                            </label>

                            <select id="orderId"
                                    name="orderId"
                                    class="form-select form-select-lg font-monospace small"
                                    required>
                                <option value="">-- Choose Order --</option>
                                @foreach (var order in Model.Orders)
                                {
                                    <option value="@order.OrderId">
                                        #@order.OrderNumber (@order.OrderDate.ToString("dd MMM yyyy")) : @order.OrderStatus : ₹@order.GrandTotal.ToString("N2")
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>Generate Invoice</span>
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>