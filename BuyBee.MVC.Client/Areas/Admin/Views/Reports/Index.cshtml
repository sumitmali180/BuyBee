@model List<EMart.ViewModels.ReportMenuItemViewModel>

@{
    ViewData["Title"] = "Business Analytics & Reports";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-bar-graph text-amber"></i>
                <span>Business Intelligence & Reports</span>
            </h1>
            <p class="text-muted small mb-0">View operational summaries, inventory levels, and tax documents</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var report in Model)
        {
            <div class="col-xl-4 col-lg-6 col-md-6">
                <div class="bb-card h-100 p-4 d-flex flex-column">
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-light border text-amber flex-shrink-0" style="width: 48px; height: 48px;">
                            <i class="bi @report.Icon fs-4"></i>
                        </div>
                        <div>
                            <h2 class="h5 fw-bold mb-1 text-dark">@report.Name</h2>
                            <p class="text-muted small mb-0">@report.Description</p>
                        </div>
                    </div>

                    <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                        @if (report.RequiresParameter)
                        {
                            <span class="badge bg-light text-secondary border small">Requires Order #</span>
                            <a asp-area="Admin"
                               asp-controller="@report.Controller"
                               asp-action="@report.Action"
                               class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
                                <i class="bi bi-receipt"></i>
                                <span>Select Order</span>
                            </a>
                        }
                        else
                        {
                            <span class="badge bg-light text-secondary border small">System Report</span>
                            <a asp-area="Admin"
                               asp-controller="@report.Controller"
                               asp-action="@report.Action"
                               class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                                <i class="bi bi-eye"></i>
                                <span>Generate</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>