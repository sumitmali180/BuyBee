@model EMart.ViewModels.PagedResult<EMart.Models.SubCategories>

@{
    ViewData["Title"] = "Sub Categories";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-diagram-3 text-amber"></i>
                <span>Sub Categories</span>
            </h1>
            <p class="text-muted small mb-0">Manage secondary classifications mapped to main categories</p>
        </div>

        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Add Sub Category</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="bb-card p-0 overflow-hidden">
        <!-- Search Filter -->
        <div class="p-3 px-4 border-bottom bg-white">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5 col-lg-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text"
                               name="searchText"
                               value="@Model.SearchText"
                               class="form-control border-start-0"
                               placeholder="Search sub category..." />
                        <button type="submit" class="btn btn-dark">Search</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.SearchText))
                {
                    <div class="col-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear Filter</a>
                    </div>
                }
            </form>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th style="width: 80px;" class="ps-4 py-3">ID</th>
                        <th class="py-3">Sub Category</th>
                        <th class="py-3">Parent Category</th>
                        <th class="py-3 text-center" style="width: 140px;">Status</th>
                        <th class="pe-4 py-3 text-end" style="width: 160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 py-3 font-monospace text-muted small">
                                    #@item.SubCategoryId
                                </td>
                                <td class="py-3">
                                    <div class="fw-semibold text-dark">@item.SubCategoryName</div>
                                </td>
                                <td class="py-3 text-secondary small">
                                    <span class="badge bg-light text-dark border">@item.CategoryName</span>
                                </td>
                                <td class="py-3 text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="bb-badge bb-badge-emerald px-2 py-0">Active</span>
                                    }
                                    else
                                    {
                                        <span class="bb-badge bb-badge-rose px-2 py-0">Inactive</span>
                                    }
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.SubCategoryId" class="btn btn-outline-secondary btn-sm p-1 px-2" title="Edit Sub Category">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.SubCategoryId" class="btn btn-outline-secondary btn-sm p-1 px-2" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.SubCategoryId" class="btn btn-outline-danger btn-sm p-1 px-2" title="Delete Sub Category">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted small">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                                No sub categories found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="p-3 px-4 border-top bg-light d-flex align-items-center justify-content-between">
                <span class="small text-muted">Page @Model.PageNumber of @Model.TotalPages</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-searchText="@Model.SearchText">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>