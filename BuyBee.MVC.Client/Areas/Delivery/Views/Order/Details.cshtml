@model EMart.ViewModels.DeliveryOrderDetailsVM

@{
    ViewData["Title"] = $"Waybill #{Model.Order.OrderNumber}";
    var order = Model.Order;
}

<div class="py-2">
    <!-- Breadcrumb & Back -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a asp-area="Delivery" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Queue
        </a>
        <span class="badge @(order.OrderStatus == "Delivered" ? "badge-status-delivered" :
                             order.OrderStatus == "Out for Delivery" ? "badge-status-outfordelivery" :
                             order.OrderStatus == "Delivery Failed" ? "badge-status-failed" : "badge-status-assigned") px-3 py-1.5 rounded-pill fs-6">
            @order.OrderStatus
        </span>
    </div>

    <!-- Waybill Header Card -->
    <div class="delivery-card p-3 p-md-4 mb-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 pb-3 border-bottom">
            <div>
                <span class="text-muted small font-monospace">WAYBILL TRACKING</span>
                <h1 class="h4 fw-bold text-dark mb-0">@order.OrderNumber</h1>
                <div class="small text-muted">
                    Placed on @order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                    @if (order.AssignedAt.HasValue)
                    {
                        <span>• Assigned @order.AssignedAt.Value.ToString("hh:mm tt")</span>
                    }
                </div>
            </div>
            <div class="text-md-end">
                <div class="text-muted small">Total Order Value</div>
                <div class="h3 fw-bold text-dark mb-0">₹@order.GrandTotal.ToString("N2")</div>
                <span class="badge @(order.PaymentMethod == "COD" ? "bg-warning text-dark" : "bg-success")">
                    @(order.PaymentMethod == "COD" ? "Cash on Delivery (COD)" : "Prepaid Online")
                </span>
            </div>
        </div>

        <!-- Payment Collection Directive -->
        @if (order.OrderStatus != "Delivered")
        {
            @if (order.PaymentMethod == "COD")
            {
                <div class="alert alert-warning p-3 rounded-3 mb-3 d-flex align-items-center gap-3">
                    <i class="bi bi-cash-stack fs-1 text-warning"></i>
                    <div>
                        <div class="fw-bold text-dark">COLLECT CASH ON DELIVERY</div>
                        <div class="small text-dark">
                            You must collect exactly <strong>₹@order.GrandTotal.ToString("N2")</strong> in cash before handing over the parcel.
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-success p-3 rounded-3 mb-3 d-flex align-items-center gap-3">
                    <i class="bi bi-check-circle-fill fs-2 text-success"></i>
                    <div>
                        <div class="fw-bold text-success">PREPAID PARCEL</div>
                        <div class="small text-muted">Payment has already been collected online. <strong>DO NOT</strong> request any cash from customer.</div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-success p-3 rounded-3 mb-3 d-flex align-items-center gap-3">
                <i class="bi bi-patch-check-fill fs-2 text-success"></i>
                <div>
                    <div class="fw-bold text-success">ORDER SUCCESSFULLY DELIVERED</div>
                    <div class="small text-muted">Delivered at @(order.DeliveredAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")</div>
                </div>
            </div>
        }

        <!-- Delivery Attempts Badge if any -->
        @if (order.DeliveryAttempts > 0)
        {
            <div class="bg-danger bg-opacity-10 border border-danger border-opacity-25 p-3 rounded-3 mb-3 text-danger small">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Delivery Attempts: @order.DeliveryAttempts</strong>
                @if (!string.IsNullOrEmpty(order.FailedReason))
                {
                    <span>• Last Issue: @order.FailedReason</span>
                }
                @if (!string.IsNullOrEmpty(order.DeliveryNotes))
                {
                    <div class="mt-1 text-muted">Notes: @order.DeliveryNotes</div>
                }
            </div>
        }
    </div>

    <!-- Customer & Destination Card -->
    <div class="delivery-card p-3 p-md-4 mb-3">
        <h2 class="h6 fw-bold text-dark mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-person-lines-fill text-success"></i>
            <span>Customer & Destination Contact</span>
        </h2>

        <div class="row g-3">
            <div class="col-md-7">
                <div class="fw-bold text-dark fs-5 mb-1">@order.CustomerName</div>
                <div class="text-muted mb-2">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                    <strong>@order.AddressLine1</strong>, @order.City, @order.State - @order.PostalCode
                </div>
                <div class="small text-muted mb-2">
                    <i class="bi bi-envelope me-1"></i> @order.CustomerEmail
                </div>
            </div>
            <div class="col-md-5 d-flex flex-column gap-2 justify-content-center">
                @if (!string.IsNullOrEmpty(order.CustomerPhone))
                {
                    <a href="tel:@order.CustomerPhone" class="btn btn-outline-success py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-telephone-fill"></i> Call Customer (@order.CustomerPhone)
                    </a>
                }
                <a href="@order.NavigationUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-cursor-fill"></i> Launch Google Maps Navigation
                </a>
            </div>
        </div>
    </div>

    <!-- Handover & OTP Verification Actions Block -->
    @if (order.OrderStatus == "Out for Delivery")
    {
        <div class="delivery-card p-3 p-md-4 mb-3 border-success border-2 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-success rounded-circle p-2"><i class="bi bi-shield-lock-fill fs-5 text-white"></i></span>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-0">Customer OTP Handover Verification</h2>
                    <p class="small text-muted mb-0">Ask customer for the 4-digit code shown on their live tracker or order email</p>
                </div>
            </div>

            <form asp-area="Delivery" asp-controller="Order" asp-action="VerifyAndDeliver" method="post" id="otpVerificationForm" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OrderId" value="@order.OrderId" />
                <input type="hidden" name="OrderNumber" value="@order.OrderNumber" />

                <div class="mb-3">
                    <label class="form-label fw-bold text-dark mb-1">
                        4-Digit Customer Delivery OTP <span class="text-danger">*</span>
                    </label>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="text"
                               name="EnteredOtp"
                               id="otpInput"
                               class="form-control form-control-lg font-monospace text-center fw-bold fs-3"
                               style="letter-spacing: 0.5rem; max-width: 240px;"
                               placeholder="••••"
                               maxlength="4"
                               pattern="[0-9]{4}"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               required />
                        <button type="submit" class="btn btn-success btn-lg px-4 fw-bold d-inline-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill fs-5"></i> Verify & Deliver
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small text-muted mb-1">Delivery Notes (Optional)</label>
                    <input type="text" name="DeliveryNotes" class="form-control form-control-sm" placeholder="e.g. Left with security guard / Delivered to recipient directly" />
                </div>

                <!-- Emergency Bypass Section -->
                <div class="mt-3 pt-3 border-top">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsBypass" value="true" id="bypassCheck" onchange="toggleBypass(this)">
                        <label class="form-check-label small text-muted" for="bypassCheck">
                            Customer phone dead or no signal? Use <strong>Emergency Manual Bypass</strong>
                        </label>
                    </div>
                    <div id="bypassContainer" class="mt-2 d-none">
                        <div class="alert alert-secondary p-2.5 small mb-2">
                            <i class="bi bi-info-circle me-1"></i> Manual bypass is logged with timestamp & driver ID. Mandatory verification reason required.
                        </div>
                        <input type="text" name="BypassReason" id="bypassReasonInput" class="form-control form-control-sm" placeholder="Reason (e.g. Customer showed government ID, phone battery empty)" />
                    </div>
                </div>
            </form>

            <!-- Report Failure Button -->
            <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Unable to reach customer or address?</span>
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#failureModal">
                    <i class="bi bi-x-circle me-1"></i> Report Delivery Issue / Reschedule
                </button>
            </div>
        </div>
    }
    else if (order.OrderStatus == "Assigned" || order.OrderStatus == "Shipped" || order.OrderStatus == "Processing")
    {
        <div class="delivery-card p-4 mb-3 text-center border-warning">
            <h2 class="h5 fw-bold mb-2">Ready to Start Delivery Run?</h2>
            <p class="small text-muted mb-3">Marking this order 'Out for Delivery' will notify the customer and prepare live tracking.</p>
            <form asp-area="Delivery" asp-controller="Order" asp-action="StartDelivery" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@order.OrderId" />
                <button type="submit" class="btn btn-warning btn-lg px-5 fw-bold text-dark d-inline-flex align-items-center gap-2">
                    <i class="bi bi-bicycle fs-4"></i> Start Out for Delivery
                </button>
            </form>
        </div>
    }

    <!-- Package Contents Summary -->
    <div class="delivery-card p-3 p-md-4 mb-4">
        <h2 class="h6 fw-bold text-dark mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-box-seam text-secondary"></i>
            <span>Package Contents (@Model.Items.Count items)</span>
        </h2>

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Item</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold small text-dark">@item.ProductName</div>
                                <div class="text-muted font-monospace" style="font-size: 0.72rem;">PID: #@item.ProductId</div>
                            </td>
                            <td class="text-center small">@item.Quantity</td>
                            <td class="text-end small">₹@item.UnitPrice.ToString("N2")</td>
                            <td class="text-end small fw-bold">₹@item.Total.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="border-top">
                    <tr>
                        <th colspan="3" class="text-end small">Subtotal:</th>
                        <th class="text-end small">₹@order.GrandTotal.ToString("N2")</th>
                    </tr>
                    <tr>
                        <th colspan="3" class="text-end small">Grand Total:</th>
                        <th class="text-end fw-bold text-success fs-6">₹@order.GrandTotal.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Failure Modal -->
<div class="modal fade" id="failureModal" tabindex="-1" aria-labelledby="failureModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-danger text-white rounded-top-4">
                <h5 class="modal-title h6 fw-bold" id="failureModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Report Delivery Issue
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-area="Delivery" asp-controller="Order" asp-action="ReportFailure" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OrderId" value="@order.OrderId" />
                <input type="hidden" name="OrderNumber" value="@order.OrderNumber" />

                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Recording an issue will increment the delivery attempt counter (Attempt #@(order.DeliveryAttempts + 1) of 3 max).
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Select Reason <span class="text-danger">*</span></label>
                        <select name="FailedReason" class="form-select rounded-3" required>
                            <option value="">-- Choose Reason --</option>
                            <option value="Customer Unavailable / Door Locked">Customer Unavailable / Door Locked</option>
                            <option value="Customer Phone Switched Off / Unreachable">Customer Phone Switched Off / Unreachable</option>
                            <option value="Wrong Address / Landmark Not Found">Wrong Address / Landmark Not Found</option>
                            <option value="Customer Refused / Cancelled">Customer Refused / Cancelled</option>
                            <option value="Customer Requested Reschedule">Customer Requested Reschedule</option>
                            <option value="Damaged Parcel / Packaging Issue">Damaged Parcel / Packaging Issue</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Partner Note (Optional)</label>
                        <textarea name="DeliveryNotes" class="form-control rounded-3" rows="3" placeholder="Add specific notes (e.g., visited at 2:30 PM, called 3 times, neighbor confirmed customer out of station)"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger fw-semibold">
                        <i class="bi bi-arrow-repeat me-1"></i> Log Failure & Reschedule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleBypass(cb) {
            const container = document.getElementById('bypassContainer');
            const otpInput = document.getElementById('otpInput');
            const reasonInput = document.getElementById('bypassReasonInput');

            if (cb.checked) {
                container.classList.remove('d-none');
                otpInput.removeAttribute('required');
                otpInput.value = '';
                otpInput.placeholder = 'BYPASS';
                reasonInput.setAttribute('required', 'required');
            } else {
                container.classList.add('d-none');
                otpInput.setAttribute('required', 'required');
                otpInput.placeholder = '••••';
                reasonInput.removeAttribute('required');
            }
        }
    </script>
}
