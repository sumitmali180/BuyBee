@model EMart.ViewModels.DeliveryDashboardVM

@{
    ViewData["Title"] = "Delivery Partner Dashboard";
}

<div class="py-2">
    <!-- Greeting & Status Card -->
    <div class="delivery-card p-3 p-md-4 mb-4" style="background: linear-gradient(135deg, #064e3b 0%, #047857 100%); color: #ffffff;">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="status-pulse"></span>
                    <span class="badge bg-white bg-opacity-20 text-white font-monospace small px-2 py-0.5">ON DUTY</span>
                    <span class="small opacity-75">@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
                </div>
                <h1 class="h4 fw-bold mb-0">Welcome back, @Model.DriverName!</h1>
                <p class="small text-white-50 mb-0">Ready for today's deliveries. Keep your GPS active.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-area="Delivery" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-light fw-semibold d-inline-flex align-items-center gap-1">
                    <i class="bi bi-list-check"></i> View Full Queue
                </a>
            </div>
        </div>
    </div>

    <!-- Shift Metrics Grid -->
    <div class="row g-3 mb-4">
        <!-- Out for Delivery -->
        <div class="col-6 col-md-3">
            <div class="delivery-card p-3 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">Active Runs</span>
                    <i class="bi bi-bicycle text-warning fs-5"></i>
                </div>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalOutForDelivery</div>
                <div class="text-muted" style="font-size: 0.75rem;">Out for delivery now</div>
            </div>
        </div>

        <!-- Assigned / Pending -->
        <div class="col-6 col-md-3">
            <div class="delivery-card p-3 border-start border-info border-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">Assigned</span>
                    <i class="bi bi-box-seam text-info fs-5"></i>
                </div>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalAssigned</div>
                <div class="text-muted" style="font-size: 0.75rem;">Awaiting dispatch pickup</div>
            </div>
        </div>

        <!-- Delivered Today -->
        <div class="col-6 col-md-3">
            <div class="delivery-card p-3 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">Delivered</span>
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                </div>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalDeliveredToday</div>
                <div class="text-muted" style="font-size: 0.75rem;">Completed today</div>
            </div>
        </div>

        <!-- Cash to Collect -->
        <div class="col-6 col-md-3">
            <div class="delivery-card p-3 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">COD to Collect</span>
                    <i class="bi bi-cash-stack text-primary fs-5"></i>
                </div>
                <div class="h4 fw-bold text-dark mb-0">₹@Model.CashToCollect.ToString("N0")</div>
                <div class="text-muted" style="font-size: 0.75rem;">Collected: ₹@Model.CashCollectedToday.ToString("N0")</div>
            </div>
        </div>
    </div>

    <!-- Active Runs Section (Out for Delivery) -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-lightning-charge-fill text-warning"></i>
                <span>Active Deliveries (In Transit)</span>
                <span class="badge bg-warning text-dark rounded-pill small">@Model.ActiveDeliveries.Count</span>
            </h2>
        </div>

        @if (Model.ActiveDeliveries.Any())
        {
            <div class="row g-3">
                @foreach (var order in Model.ActiveDeliveries)
                {
                    <div class="col-12 col-lg-6">
                        <div class="delivery-card p-3 border-warning border-2">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge badge-status-outfordelivery px-2 py-1 rounded-pill small fw-semibold">
                                        <i class="bi bi-bicycle me-1"></i> Out for Delivery
                                    </span>
                                    <h3 class="h6 fw-bold text-dark mt-1 mb-0">@order.OrderNumber</h3>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-dark fs-5">₹@order.GrandTotal.ToString("N2")</div>
                                    <span class="badge @(order.PaymentMethod == "COD" ? "bg-warning text-dark" : "bg-success") small">
                                        @order.PaymentMethod
                                    </span>
                                </div>
                            </div>

                            <!-- Customer Info -->
                            <div class="bg-light p-2.5 rounded-3 mb-3 small">
                                <div class="fw-bold text-dark mb-1">
                                    <i class="bi bi-person-fill text-muted me-1"></i> @order.CustomerName
                                </div>
                                <div class="text-muted mb-2">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> @order.FullAddress
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (!string.IsNullOrEmpty(order.CustomerPhone))
                                    {
                                        <a href="tel:@order.CustomerPhone" class="btn btn-sm btn-outline-success py-1 px-2 rounded-pill">
                                            <i class="bi bi-telephone-fill me-1"></i> Call (@order.CustomerPhone)
                                        </a>
                                    }
                                    <a href="@order.NavigationUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary py-1 px-2 rounded-pill">
                                        <i class="bi bi-cursor-fill me-1"></i> Maps GPS
                                    </a>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex gap-2">
                                <a asp-area="Delivery" asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-success flex-grow-1 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-shield-check fs-5"></i> Enter 4-Digit OTP & Deliver
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="delivery-card p-4 text-center text-muted">
                <i class="bi bi-check2-circle fs-1 text-success opacity-50 mb-2"></i>
                <p class="mb-1 fw-semibold">No deliveries currently in transit.</p>
                <p class="small text-muted mb-0">Select an assigned order from your queue below and click "Start Delivery".</p>
            </div>
        }
    </div>

    <!-- Assigned Queue Section -->
    <div>
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-inbox-fill text-info"></i>
                <span>Ready for Delivery (Assigned Queue)</span>
                <span class="badge bg-info text-dark rounded-pill small">@Model.AssignedQueue.Count</span>
            </h2>
        </div>

        @if (Model.AssignedQueue.Any())
        {
            <div class="row g-3">
                @foreach (var order in Model.AssignedQueue)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="delivery-card p-3 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge badge-status-assigned px-2 py-0.5 rounded-pill small">
                                            @order.OrderStatus
                                        </span>
                                        <div class="fw-bold text-dark mt-1">@order.OrderNumber</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-dark">₹@order.GrandTotal.ToString("N2")</div>
                                        <span class="badge @(order.PaymentMethod == "COD" ? "bg-warning text-dark" : "bg-success")" style="font-size: 0.7rem;">
                                            @order.PaymentMethod
                                        </span>
                                    </div>
                                </div>

                                <div class="small text-muted mb-3">
                                    <div class="text-dark fw-semibold mb-1">
                                        <i class="bi bi-person me-1"></i> @order.CustomerName
                                    </div>
                                    <div class="text-truncate-2">
                                        <i class="bi bi-geo-alt me-1 text-muted"></i> @order.FullAddress
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 pt-2 border-top">
                                <a asp-area="Delivery" asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-secondary flex-grow-1">
                                    Waybill Details
                                </a>
                                <form asp-area="Delivery" asp-controller="Order" asp-action="StartDelivery" method="post" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@order.OrderId" />
                                    <button type="submit" class="btn btn-sm btn-success w-100 fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                                        <i class="bi bi-play-fill"></i> Start Run
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="delivery-card p-4 text-center text-muted">
                <i class="bi bi-inbox fs-1 text-muted opacity-50 mb-2"></i>
                <p class="mb-0 fw-semibold">No assigned orders waiting in your queue.</p>
                <p class="small text-muted mb-0">New orders dispatched by admin logistics will appear here.</p>
            </div>
        }
    </div>
</div>
