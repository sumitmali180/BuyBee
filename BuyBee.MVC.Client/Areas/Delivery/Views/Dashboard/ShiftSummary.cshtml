@model EMart.ViewModels.DeliveryShiftMetrics

@{
    ViewData["Title"] = "Shift & Cash Handover Summary";
    var deliveredOrders = ViewBag.DeliveredToday as List<EMart.ViewModels.DeliveryOrderSummaryVM> ?? new List<EMart.ViewModels.DeliveryOrderSummaryVM>();
}

<div class="py-2">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h4 fw-bold mb-0">Shift & Cash Handover</h1>
            <p class="text-muted small mb-0">Reconcile cash collected and completed deliveries for today</p>
        </div>
        <a asp-area="Delivery" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
    </div>

    <!-- Cash Handover Card -->
    <div class="delivery-card p-4 mb-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #ffffff;">
        <div class="row align-items-center g-3">
            <div class="col-md-7">
                <span class="badge bg-warning text-dark font-monospace text-uppercase small px-2 py-1 mb-2">
                    <i class="bi bi-cash-stack me-1"></i> Cash on Delivery (COD) Ledger
                </span>
                <h2 class="h3 fw-bold mb-1">Total COD Cash Collected Today</h2>
                <div class="display-5 fw-extrabold text-warning">₹@Model.CashCollectedToday.ToString("N2")</div>
                <p class="small text-white-50 mt-2 mb-0">
                    Hand this cash over to the logistics hub cashier at the end of your shift.
                </p>
            </div>
            <div class="col-md-5 text-md-end">
                <div class="bg-white bg-opacity-10 p-3 rounded-3 text-start">
                    <div class="d-flex justify-content-between small text-white-50 mb-1">
                        <span>Delivered Today:</span>
                        <strong class="text-white">@Model.TotalDeliveredToday orders</strong>
                    </div>
                    <div class="d-flex justify-content-between small text-white-50 mb-1">
                        <span>Pending COD to Collect:</span>
                        <strong class="text-warning">₹@Model.CashToCollect.ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between small text-white-50">
                        <span>Delivery Failures:</span>
                        <strong class="text-danger">@Model.TotalFailed</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Today's Delivered Orders List -->
    <div class="delivery-card p-4">
        <h3 class="h6 fw-bold text-dark mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-check2-all text-success"></i>
            <span>Orders Delivered Today (@deliveredOrders.Count)</span>
        </h3>

        @if (deliveredOrders.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Delivered At</th>
                            <th>Payment</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in deliveredOrders)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <a asp-area="Delivery" asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId" class="text-decoration-none text-dark">
                                        @order.OrderNumber
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold small">@order.CustomerName</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@order.CustomerPhone</div>
                                </td>
                                <td class="small text-muted">
                                    @(order.DeliveredAt?.ToString("hh:mm tt") ?? "-")
                                </td>
                                <td>
                                    <span class="badge @(order.PaymentMethod == "COD" ? "bg-warning text-dark" : "bg-success")">
                                        @order.PaymentMethod
                                    </span>
                                </td>
                                <td class="text-end fw-bold">
                                    ₹@order.GrandTotal.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-calendar-x fs-2 opacity-50 mb-2"></i>
                <p class="mb-0 small">No deliveries completed yet today.</p>
            </div>
        }
    </div>
</div>
