@model EMart.ViewModels.LoginVM

@{
    ViewData["Title"] = "Delivery Partner Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Buybee Express - Delivery Partner Portal</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --delivery-primary: #059669;
            --delivery-dark: #064e3b;
            --delivery-accent: #f59e0b;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #064e3b 0%, #0f172a 100%);
            min-height: 100vh;
        }
        .delivery-login-card {
            border-radius: 1.25rem;
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .badge-driver {
            background-color: #d1fae5;
            color: #065f46;
            font-weight: 600;
            letter-spacing: 0.05em;
        }
    </style>
</head>

<body class="d-flex align-items-center justify-content-center p-3">
    <div class="container" style="max-width: 440px;">
        <div class="delivery-login-card bg-white p-4 p-sm-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-truck fs-1"></i>
                </div>
                <div class="d-block mb-2">
                    <span class="badge badge-driver px-3 py-1 rounded-pill text-uppercase small">
                        <i class="bi bi-geo-alt-fill me-1"></i> Buybee Express
                    </span>
                </div>
                <h1 class="h4 fw-bold text-dark mb-1">Delivery Partner Portal</h1>
                <p class="text-muted small mb-0">Sign in to view your assigned deliveries & shift tasks</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div class="alert alert-danger p-3 small rounded-3 mb-3 d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-danger flex-shrink-0 mt-1"></i>
                    <div>@Html.ValidationSummary(true)</div>
                </div>
            }

            <form asp-area="Delivery"
                  asp-controller="Account"
                  asp-action="Login"
                  asp-route-returnUrl="@ViewBag.ReturnUrl"
                  method="post"
                  id="deliveryLoginForm">
                @Html.AntiForgeryToken()

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control rounded-3" id="driverEmail" placeholder="driver@buybee.com" autocomplete="email" required />
                    <label asp-for="Email"><i class="bi bi-envelope me-1"></i> Partner Email</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control rounded-3" id="driverPassword" type="password" placeholder="Password" autocomplete="current-password" required />
                    <label asp-for="Password"><i class="bi bi-key me-1"></i> Password</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-success w-100 py-3 fw-bold rounded-3 shadow-sm d-inline-flex align-items-center justify-content-center gap-2 mt-2">
                    <i class="bi bi-box-arrow-in-right fs-5"></i>
                    <span>Start Shift / Sign In</span>
                </button>
            </form>

            <!-- Quick fill helper for testing / demonstration -->
            <div class="mt-4 pt-3 border-top text-center">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="fillTestDriver()">
                    <i class="bi bi-lightning-fill text-warning me-1"></i> Fill Demo Driver Credentials
                </button>
                <div class="mt-3">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i> Return to Storefront
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function fillTestDriver() {
            document.getElementById('driverEmail').value = 'driver@buybee.com';
            document.getElementById('driverPassword').value = 'Password@123';
        }
    </script>
</body>
</html>
