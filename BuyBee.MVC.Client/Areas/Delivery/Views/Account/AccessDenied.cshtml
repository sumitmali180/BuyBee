@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - Buybee Express</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-light min-vh-100 d-flex align-items-center justify-content-center p-3">
    <div class="text-center" style="max-width: 450px;">
        <div class="display-1 text-danger mb-3">
            <i class="bi bi-shield-x"></i>
        </div>
        <h1 class="h3 fw-bold mb-2">Access Denied</h1>
        <p class="text-muted mb-4">
            You do not have permission to access the Delivery Partner portal. Only verified delivery riders with active credentials can enter.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-area="Delivery" asp-controller="Account" asp-action="Login" class="btn btn-success">
                <i class="bi bi-box-arrow-in-right me-1"></i> Partner Login
            </a>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-house me-1"></i> Return Home
            </a>
        </div>
    </div>
</body>
</html>
